---
// Ref: Plerdy 2025 — info lokasi di atas + bawah, nav About/Menus/Reservations jelas, CTA Reserve/Order di tiap segmen.
import { business } from '../data/business';
interface Props {
  waHref: string;
}
const { waHref } = Astro.props;
const cells = [
  { label: 'Alamat', value: business.address, sub: 'Danau Sipin, Kota Jambi' },
  { label: 'Jam buka', value: business.hours, sub: 'Padat 12.00–13.30 & 18.30–21.00' },
  { label: 'Reservasi WA', value: '0822-8052-3250', sub: 'Balas cepat jam buka', href: waHref },
];
---
<!-- Ref: Plerdy 2025 — info strip Alamat/Jam/WA + CTA rute, stack di mobile -->
<section aria-label="Info kunjungan" class="max-w-6xl mx-auto px-4">
  <div class="border border-orange-800/15 rounded-3xl bg-white/60 overflow-hidden">
    <dl class="flex flex-col md:flex-row md:divide-x divide-orange-800/15">
      {cells.map((c) => (
        <div class="flex-1 px-6 py-5 min-w-0">
          <dt class="text-xs font-semibold tracking-[0.14em] uppercase text-orange-800">{c.label}</dt>
          <dd class="mt-1 font-semibold text-[15px] leading-snug break-words">{c.value}</dd>
          <dd class="mt-0.5 text-sm text-stone-500">{c.sub}</dd>
        </div>
      ))}
    </dl>
    <div class="flex flex-col sm:flex-row gap-3 border-t border-orange-800/15 px-6 py-4">
      <a href={business.mapsUrl} target="_blank" rel="noopener" class="flex-1 text-center border border-stone-300 px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold hover:border-orange-800 hover:text-orange-800 active:scale-[0.97] transition">Rute ke lokasi</a>
      <a href={waHref} target="_blank" rel="noopener" class="flex-1 text-center bg-orange-800 text-orange-50 px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold hover:-translate-y-0.5 active:scale-[0.97] transition">Chat WA reservasi</a>
    </div>
  </div>
</section>
