---
// Ref: menu journal — strip info kunjungan (alamat/jam/WA) sebagai satu sumber kebenaran dari business.ts.
import { business } from '../data/business';
interface Props {
  waHref: string;
}
const { waHref } = Astro.props;
const cells = [
  { label: 'Alamat', value: business.address, href: business.mapsUrl, external: true },
  { label: 'Jam buka', value: business.hours },
  { label: 'Kisaran harga', value: business.priceRange, sub: 'Estimasi — konfirmasi via WA' },
  { label: 'Reservasi WA', value: '0822-8052-3250', sub: 'Dibalas cepat saat jam buka', href: waHref, external: true },
];
---
<!-- Ref: strip info kunjungan — grid + divide rule, runtuh rapi di mobile -->
<section aria-label="Info kunjungan" class="border border-olive/30 rounded-3xl overflow-hidden bg-paper-2/50">
  <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-y divide-olive/25 sm:divide-y-0 sm:divide-x border-b border-olive/25">
    {cells.map((c) => (
      <div class="px-6 py-5 min-w-0">
        <dt class="text-[11px] font-semibold tracking-[0.16em] uppercase text-olive">{c.label}</dt>
        <dd class="mt-1.5 font-medium text-[15px] leading-snug break-words text-ink">
          {c.href ? <a href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined} class="underline underline-offset-4 decoration-olive/40 hover:decoration-accent">{c.value}</a> : c.value}
        </dd>
        {c.sub && <dd class="mt-1 text-sm text-ink-muted">{c.sub}</dd>}
      </div>
    ))}
  </dl>
  <div class="grid sm:grid-cols-2 gap-3 px-6 py-4">
    <a href={business.mapsUrl} target="_blank" rel="noopener" class="text-center border border-olive/40 px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold text-ink hover:border-accent hover:text-accent active:scale-[0.98] transition">Rute ke lokasi</a>
    <a href={waHref} target="_blank" rel="noopener" class="text-center bg-accent text-paper px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold hover:opacity-90 active:scale-[0.98] transition">Chat WA reservasi</a>
  </div>
</section>
