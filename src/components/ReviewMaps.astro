---
/* Ref: menu journal — blok lokasi: alamat, jam buka, MapFacade (klik-untuk-muat), CTA reservasi WhatsApp.
   Catatan: tidak ada testimoni/kutipan yang dikarang. Hanya rating agregat dari data bisnis + tautan ulasan Google. */
import { business, waLink } from '../data/business';
import MapFacade from './MapFacade.astro';
const wa = waLink(`Halo ${business.name}, saya mau reservasi meja.`);
---
<!-- Ref: lokasi 2 kolom — peta facade di kiri, detail kunjungan + CTA di kanan -->
<section aria-label="Lokasi dan ulasan">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
    <div class="md:col-span-7 min-w-0">
      <MapFacade />
    </div>
    <div class="md:col-span-5 min-w-0">
      <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-ink/60">Lokasi</p>
      <h2 class="mt-3 font-display text-3xl md:text-4xl font-semibold tracking-tight leading-[1.05]">Danau Sipin, Kota Jambi</h2>
      <dl class="mt-6 divide-y divide-ink/25 border-t border-ink/30">
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4">
          <dt class="text-[11px] font-semibold tracking-[0.14em] uppercase text-ink/60 pt-1">Alamat</dt>
          <dd class="text-[15px] leading-relaxed">{business.address}</dd>
        </div>
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4">
          <dt class="text-[11px] font-semibold tracking-[0.14em] uppercase text-ink/60 pt-1">Jam buka</dt>
          <dd class="text-[15px] leading-relaxed">{business.hours}</dd>
        </div>
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4">
          <dt class="text-[11px] font-semibold tracking-[0.14em] uppercase text-ink/60 pt-1">Ulasan</dt>
          <dd class="text-[15px] leading-relaxed">
            <span class="font-mono-num font-semibold">{business.rating}</span> dari 5 &middot; {business.reviewCount} ulasan Google.
            <a href={business.mapsUrl} target="_blank" rel="noopener" class="text-accent underline underline-offset-4 decoration-accent/40">Baca ulasan di Maps</a>.
          </dd>
        </div>
      </dl>
      <div class="mt-6 grid sm:grid-cols-2 gap-3">
        <a href={wa} target="_blank" rel="noopener" class="text-center bg-accent text-paper px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold hover:opacity-90 active:scale-[0.98] transition">Reservasi via WA</a>
        <a href={business.mapsUrl} target="_blank" rel="noopener" class="text-center border border-ink/40 px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold text-ink hover:border-accent hover:text-accent active:scale-[0.98] transition">Rute ke lokasi</a>
      </div>
    </div>
  </div>
</section>
