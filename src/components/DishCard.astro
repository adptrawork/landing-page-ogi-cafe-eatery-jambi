---
/* Ref: menu journal/food editorial — baris menu dua kolom seperti menu cetak (rule + leader titik + harga).
   Foto menu lokal (Wikimedia Commons, lisensi bebas — lihat README tabel Sumber Gambar). */
/* PERF: img lokal — decoding async; item pertama eager+fetchpriority, sisanya lazy. */
interface Props {
  name: string;
  price: string;
  badge: string;
  desc: string;
  seed: string;
  waHref: string;
  cat: string;
  index?: number;
  eager?: boolean;
}
const { name, price, badge, desc, seed, waHref, cat, index = 0, eager = false } = Astro.props;
const dims: Record<string, [number, number]> = {
  'ogi-chicken-katsu-don': [240, 160],
  'ogi-chicken-quesadilla': [240, 180],
  'ogi-nasi-goreng-ogi-spesial': [240, 160],
  'ogi-ayam-geprek-sambal-matah-nasi': [240, 156],
  'ogi-spaghetti-aglio-e-olio-carbonara': [240, 160],
  'ogi-burger-french-fries': [240, 156],
  'ogi-matcha-latte-hot-ice': [240, 135],
  'ogi-kopi-susu-gula-aren': [240, 427],
  'ogi-pisang-goreng-coklat-keju': [240, 144],
  'ogi-thai-tea-lemon-tea': [240, 240],
};
const localSrc = `/images/${seed}.webp`;
const [imgW, imgH] = dims[seed] ?? [800, 450];
const teruji = badge === 'Teruji';
const badgeCls = teruji
  ? 'bg-accent text-paper'
  : 'border border-ink/60 text-ink/70';
---
<article class="dish group grid grid-cols-[84px_1fr] sm:grid-cols-[104px_1fr] gap-4 sm:gap-5 border-t border-ink/60 py-6 min-w-0" data-cat={cat} style={`--i:${index}`}>
  <div class="overflow-hidden rounded-2xl bg-ink/6 self-start">
    <img src={localSrc} alt={name} width={imgW} height={imgH} decoding="async" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} class="dish-img w-full h-[84px] sm:h-[104px] object-cover" />
  </div>
  <div class="min-w-0">
    <div class="grid grid-cols-[auto_1fr_auto] items-end gap-x-3">
      <h3 class="font-display text-base sm:text-lg font-semibold leading-snug tracking-tight">{name}</h3>
      <span class="leader" aria-hidden="true"></span>
      <p class="font-mono-num text-sm sm:text-base font-semibold text-accent whitespace-nowrap">{price}</p>
    </div>
    <p class="mt-1.5 text-sm leading-relaxed text-ink/75">{desc}</p>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <span class={`text-[11px] font-semibold tracking-wide uppercase rounded-full px-3 py-1 ${badgeCls}`}>{badge}</span>
      <a href={waHref} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent underline underline-offset-4 decoration-accent/40 hover:decoration-accent min-h-[44px] active:scale-[0.98] transition-transform">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.7-5.2A8.5 8.5 0 1 1 21 11.5Z" /><path d="M8.5 9.5c0 3 2 5 5 5" /></svg>
        Pesan via WA
      </a>
    </div>
  </div>
</article>
