---
/* Ref: Awwwards GEM — on-hover dish preview (foto zoom + info); Ref: Themetags — menu highlight visual, tanpa foto generik (foto asli/seed per item). */
/* PERF: img lokal — decoding async; highlight pertama eager+fetchpriority, sisanya lazy. */
interface Props {
  name: string;
  price: string;
  badge: string;
  desc: string;
  seed: string;
  waHref: string;
  eager?: boolean;
}
const { name, price, badge, desc, seed, waHref, eager = false } = Astro.props;
/* Foto menu lokal (Wikimedia Commons, bebas lisensi — lihat README tabel Sumber Gambar). */
const dims: Record<string, [number, number]> = {
  'ogi-chicken-katsu-don': [800, 532],
  'ogi-chicken-quesadilla': [800, 600],
  'ogi-nasi-goreng-ogi-spesial': [800, 533],
  'ogi-ayam-geprek-sambal-matah-nasi': [800, 520],
  'ogi-spaghetti-aglio-e-olio-carbonara': [800, 533],
  'ogi-burger-french-fries': [800, 519],
  'ogi-matcha-latte-hot-ice': [800, 450],
  'ogi-kopi-susu-gula-aren': [800, 1422],
  'ogi-pisang-goreng-coklat-keju': [800, 480],
  'ogi-thai-tea-lemon-tea': [800, 800],
};
const localSrc = `/images/${seed}.jpg`;
const [imgW, imgH] = dims[seed] ?? [800, 450];
---
<article class="dish group border border-orange-800/15 rounded-3xl overflow-hidden bg-white/60 flex flex-col">
  <div class="relative overflow-hidden">
    <img src={localSrc} alt={name} width={imgW} height={imgH} decoding="async" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} class="dish-img w-full aspect-video object-cover" />
    <span class="absolute left-3 top-3 text-[11px] font-bold tracking-wide uppercase bg-[#faf6f1]/95 text-orange-800 border border-orange-800/25 rounded-full px-3 py-1">{badge}</span>
    <span class="absolute right-3 bottom-3 font-mono-num text-xs font-semibold bg-stone-900/80 text-white rounded-full px-3 py-1.5 opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition duration-300">Lihat detail →</span>
  </div>
  <div class="p-5 sm:p-6 flex flex-col flex-1">
    <h3 class="font-bold text-lg tracking-tight leading-snug">{name}</h3>
    <p class="mt-1 text-sm text-stone-500">{desc}</p>
    <div class="mt-4 pt-4 border-t border-orange-800/10 flex items-center justify-between gap-3 mt-auto">
      <p class="font-mono-num font-semibold text-orange-800 whitespace-nowrap">{price}</p>
      <a href={waHref} target="_blank" rel="noopener" class="border border-orange-800 text-orange-800 px-5 py-2.5 min-h-[48px] inline-flex items-center rounded-full text-sm font-semibold hover:bg-orange-800 hover:text-orange-50 active:scale-[0.97] transition">Pesan via WA</a>
    </div>
  </div>
</article>
