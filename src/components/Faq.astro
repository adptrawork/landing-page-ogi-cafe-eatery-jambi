---
/* Ref: menu journal — FAQ accordion ber-rule, aksen ikon plus yang berputar (transform only). */
interface Item { q: string; a: string; }
interface Props { faqs: Item[]; }
const { faqs } = Astro.props;
---
<div class="divide-y divide-ink/25 border-y border-ink/30">
  {faqs.map((f) => (
    <details class="py-4 group min-w-0">
      <summary class="cursor-pointer font-semibold text-[15px] list-none grid grid-cols-[1fr_auto] items-center gap-4 min-h-[48px] min-w-0">
        <span class="min-w-0 break-words">{f.q}</span>
        <svg class="text-accent shrink-0 transition-transform duration-300 group-open:rotate-45" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
      </summary>
      <p class="mt-1 text-sm leading-relaxed text-ink/75 max-w-[65ch]">{f.a}</p>
    </details>
  ))}
</div>
