---
// Ref: Awwwards GEM maps integration — FACADE: preview + tombol, iframe disuntik hanya saat diklik.
import { business } from '../data/business';
---
<div class="mapfacade rounded-3xl overflow-hidden border border-orange-800/15 bg-orange-800/5" data-embed={business.mapsEmbed} data-title={`Peta ${business.name}`}>
  <div class="aspect-[4/3] flex flex-col items-center justify-center gap-3 p-6 text-center">
    <p class="font-bold text-[15px]">Peta dimuat sesuai permintaan</p>
    <p class="text-sm text-stone-500 max-w-[40ch]">{business.address}</p>
    <button type="button" data-loadmap class="bg-orange-800 text-orange-50 px-6 py-3 min-h-[48px] rounded-full text-sm font-semibold hover:-translate-y-0.5 active:scale-[0.97] transition">Muat peta interaktif</button>
    <a href={business.mapsUrl} target="_blank" rel="noopener" class="text-sm underline underline-offset-4 decoration-orange-800">Buka di Google Maps</a>
  </div>
</div>
