---
// Ref: menu journal — alur reservasi 3 langkah sebagai daftar ber-rule + CTA WA.
import { waLink, business } from '../data/business';
const wa = waLink(`Halo ${business.name}, saya mau reservasi meja.`);
const steps = [
  { n: '01', t: 'Isi form satu menit', d: 'Nama, tanggal, jam, dan jumlah orang. Tanpa akun, tanpa aplikasi.' },
  { n: '02', t: 'Kirim lewat WhatsApp', d: 'Pesan terformat rapi langsung terbuka di WhatsApp admin.' },
  { n: '03', t: 'Admin konfirmasi slot', d: 'Tunggu balasan; meja disiapkan sebelum kamu datang.' },
];
---
<!-- Ref: cerita alur reservasi 2 kolom (kiri narasi, kanan daftar ber-rule) -->
<section aria-label="Cara reservasi">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
    <div class="md:col-span-4 min-w-0">
      <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-ink/70">Cara reservasi</p>
      <h2 class="mt-3 font-display text-3xl md:text-4xl font-semibold tracking-tight leading-[1.05]">Amankan meja dalam tiga langkah</h2>
      <p class="mt-4 text-base leading-relaxed text-ink/75">Grup lebih dari 6 orang atau malam minggu: reservasi H-1 agar meja disiapkan.</p>
      <a href={wa} target="_blank" rel="noopener" class="mt-6 inline-flex items-center justify-center bg-accent text-paper px-7 py-3.5 min-h-[48px] rounded-full font-semibold hover:opacity-90 active:scale-[0.98] transition">Chat WA sekarang</a>
      <p class="mt-3 text-xs leading-relaxed text-ink/70">Jam padat 12.00&ndash;13.30 &amp; 18.30&ndash;21.00 WIB &mdash; datang 30 menit lebih awal.</p>
    </div>
    <ol class="md:col-span-8 grid divide-y divide-ink/60 border-t border-ink/60">
      {steps.map((s) => (
        <li class="grid grid-cols-[auto_1fr] gap-5 py-6 min-w-0">
          <span class="font-mono-num text-sm text-accent pt-1" aria-hidden="true">{s.n}</span>
          <div class="min-w-0">
            <h3 class="font-display text-lg font-semibold tracking-tight">{s.t}</h3>
            <p class="mt-1 text-[15px] leading-relaxed text-ink/75">{s.d}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
