---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, gallery } from '../data/business';
---
<BaseLayout title={`Galeri ${business.name} — Interior & Suasana`} description={`Galeri foto ${business.name} Jambi: interior cozy, outdoor, spot foto. Foto placeholder picsum, ganti foto asli berizin.`} canonicalPath="/galeri">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <p class="text-sm font-medium text-rose-700">Galeri</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Suasana OGI</h1>
    <p class="mt-3 text-base text-gray-600 max-w-[65ch]">Foto di bawah placeholder relevan (picsum seed). Ganti dengan foto asli interior/menu berizin pemilik sebelum launch. Lihat referensi asli di <a class="underline" href={business.instagram}>Instagram @ogi.cafeneatery</a>.</p>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-6">
      {gallery.map((g, i) => (
        <figure class={i % 3 === 0 ? 'md:col-span-7' : 'md:col-span-5'}>
          <div class="rounded-[2.5rem] overflow-hidden border border-slate-200/50 bg-white">
            <img src={`https://picsum.photos/seed/${g.seed}/800/600`} alt={g.alt} width="800" height="600" loading="lazy" class="w-full aspect-[4/3] object-cover" />
            <figcaption class="p-4 text-sm text-zinc-500">{g.caption}</figcaption>
          </div>
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>
