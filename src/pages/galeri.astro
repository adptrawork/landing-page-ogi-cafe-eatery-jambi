---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, gallery } from '../data/business';
---
<BaseLayout title="Galeri OGI Cafe Jambi — Suasana Nongkrong Danau Sipin" description="Galeri OGI Cafe Jambi: interior cozy, area outdoor, menu andalan, dan spot foto. Ketuk tiap panel untuk membuka. Foto placeholder, ganti foto asli berizin." canonicalPath="/galeri">
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end">
      <div class="md:col-span-8">
        <p class="text-sm font-semibold text-orange-800">Galeri &bull; <span class="font-mono-num">{String(gallery.length).padStart(2, '0')} panel</span></p>
        <h1 class="mt-2 text-4xl md:text-6xl tracking-tight leading-[1.02] font-extrabold">Buka panelnya, rasakan nongkrongnya</h1>
        <p class="mt-3 text-base text-stone-600 max-w-[65ch]">Galeri vertikal: ketuk tiap judul untuk membuka fotonya. Foto placeholder (picsum seed) &mdash; ganti foto asli berizin sebelum launch. Referensi: <a class="underline underline-offset-4 decoration-orange-800" href={business.instagram} target="_blank" rel="noopener">Instagram @ogi.cafeneatery</a>.</p>
      </div>
      <div class="md:col-span-4">
        <p class="font-mono-num text-xs text-stone-500 border border-orange-800/20 rounded-2xl p-4">Panel pertama terbuka otomatis. Sisanya menunggu diketuk &mdash; hemat scroll, hemat penasaran.</p>
      </div>
    </div>
    <div class="mt-8 border-t-2 border-orange-800">
      {gallery.map((g, i) => (
        <details class="acc border-b border-orange-800/15" open={i === 0 ? true : undefined}>
          <summary class="cursor-pointer list-none flex items-center gap-4 py-5">
            <span class="font-mono-num text-sm text-orange-800">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-bold text-lg tracking-tight flex-1">{g.alt}</span>
            <span class="acc-plus text-orange-800 text-2xl leading-none font-light">+</span>
          </summary>
          <div class="acc-panel">
            <div class="acc-inner">
              <figure class="acc-img pb-6 md:pl-12">
                <img src={`https://picsum.photos/seed/${g.seed}/1000/620`} alt={g.alt} width="1000" height="620" loading={i === 0 ? 'eager' : 'lazy'} class="w-full aspect-[16/10] object-cover rounded-3xl" />
                <figcaption class="mt-2 text-sm text-stone-500">{g.caption}</figcaption>
              </figure>
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
