---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, waLink } from '../data/business';
import { gallery } from '../data/menu-journal';
const spans = ['md:col-span-3', 'md:col-span-3', 'md:col-span-3', 'md:col-span-3', 'md:col-span-2', 'md:col-span-4'];
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://ogicafe-jambi.pages.dev/' },
    { '@type': 'ListItem', position: 2, name: 'Galeri', item: 'https://ogicafe-jambi.pages.dev/galeri' },
  ],
};
---
<BaseLayout title="Galeri OGI Cafe Jambi — Suasana Nongkrong Danau Sipin" description="Galeri suasana OGI Cafe Jambi Danau Sipin: ruang indoor, teras outdoor, meja makan, dan kopi. Foto ilustrasi Wikimedia Commons, bukan foto lokasi OGI." canonicalPath="/galeri">
  <!-- Ref: kolase editorial asimetris — span foto bervariasi, bukan grid seragam -->
  <!-- 01 HERO -->
  <section class="max-w-6xl mx-auto px-4 w-full pt-10 md:pt-16 pb-6">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-end">
      <div class="md:col-span-8 min-w-0">
        <p class="reveal text-[11px] font-semibold tracking-[0.18em] uppercase text-ink/70" style="--i:0">Galeri &middot; <span class="font-mono-num">{String(gallery.length).padStart(2, '0')} foto</span></p>
        <h1 class="reveal mt-5 font-display text-4xl sm:text-5xl md:text-6xl font-semibold leading-[1.02] tracking-tight max-w-[18ch]" style="--i:1">
          Suasana yang menemani setiap meja
        </h1>
      </div>
      <p class="reveal md:col-span-4 text-sm leading-relaxed text-ink/70" style="--i:2">
        Foto di bawah adalah <strong class="text-ink">ilustrasi suasana</strong> dari Wikimedia Commons (lisensi bebas),
        bukan foto lokasi OGI. Ikuti <a class="text-accent underline underline-offset-4 decoration-accent/40" href={business.instagram} target="_blank" rel="noopener">Instagram @ogi.cafeneatery</a> untuk foto asli.
      </p>
    </div>
  </section>

  <!-- 02 KOLASE FOTO -->
  <section aria-label="Kolase suasana" class="max-w-6xl mx-auto px-4 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-6 gap-4 md:gap-5">
      {gallery.map((g, i) => (
        <figure class={`reveal min-w-0 ${spans[i]}`} style={`--i:${i}`}>
          <img src={g.src} alt={g.alt} width={g.w} height={g.h} decoding="async" loading={i < 2 ? 'eager' : 'lazy'} class="w-full aspect-[4/3] object-cover rounded-3xl bg-ink/6" />
          <figcaption class="mt-2 text-sm text-ink/70">{g.caption}</figcaption>
        </figure>
      ))}
    </div>
    <p class="mt-6 text-xs leading-relaxed text-ink/70 max-w-[70ch]">
      Kredit gambar: Wikimedia Commons — CC BY 4.0, CC BY-SA 2.0/4.0, dan Public domain. Daftar lengkap tautan &amp; penulis ada di README repositori.
    </p>
  </section>

  <!-- 03 CTA -->
  <section class="max-w-6xl mx-auto px-4 py-10 md:py-16 border-t border-ink/60">
    <div class="grid md:grid-cols-[1fr_auto] gap-5 items-center">
      <p class="font-display text-2xl md:text-3xl font-semibold tracking-tight leading-snug max-w-[26ch]">Sudah terbayang mau duduk di mana? Amankan mejamu dulu.</p>
      <div class="grid sm:grid-cols-2 md:flex gap-3">
        <a href={waLink(`Halo ${business.name}, saya mau reservasi meja.`)} target="_blank" rel="noopener" class="text-center bg-accent text-paper px-7 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-semibold hover:opacity-90 active:scale-[0.98] transition">Reservasi via WA</a>
        <a href="/menu" class="text-center border border-ink/60 px-7 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-semibold text-ink hover:border-accent hover:text-accent active:scale-[0.98] transition">Lihat e-menu</a>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</BaseLayout>
