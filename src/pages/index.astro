---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, menuGroups, waLink } from '../data/business';
---
<BaseLayout title={business.title} description={business.description} canonicalPath="/" image={business.ogImage}>
  <section class="max-w-7xl mx-auto px-4 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center min-h-[88dvh] py-10">
      <div class="md:col-span-7">
        <p class="flex items-center gap-2 text-sm font-medium text-rose-700">
          <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M128 16l36 74 82 12-59 58 14 82-73-38-73 38 14-82-59-58 82-12z"/></svg>
          <span class="font-mono-num">{business.rating} (670 ulasan)</span>
          <span class="text-zinc-500">• Danau Sipin • {business.priceRange}</span>
        </p>
        <h1 class="mt-4 text-4xl md:text-6xl tracking-tighter leading-none font-bold">OGI Cafe and Eatery — Nongkrong & Makan Enak di Jambi</h1>
        <p class="mt-5 text-base text-gray-600 leading-relaxed max-w-[65ch]">Kafe all-rounder di Jl. Empu Sendok No.54. Parkir luas, spot foto melimpah, board games, menu Nusantara–Western–Jepang. {business.hours}.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/menu" class="bg-rose-700 text-white px-7 py-3.5 rounded-full font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]">Lihat E-Menu</a>
          <a href="/reservasi" class="border border-zinc-300 px-7 py-3.5 rounded-full font-medium hover:border-zinc-950 active:scale-[0.98]">Reservasi Meja</a>
        </div>
        <div class="mt-8 flex divide-x divide-zinc-200 border-t border-zinc-200 pt-5 text-sm">
          <div class="pr-6"><p class="font-mono-num font-semibold">4.8</p><p class="text-zinc-500">670 ulasan</p></div>
          <div class="px-6"><p class="font-mono-num font-semibold">11–22.30</p><p class="text-zinc-500">Buka tiap hari</p></div>
          <div class="pl-6"><p class="font-mono-num font-semibold">0822-8052-3250</p><p class="text-zinc-500">Reservasi WA</p></div>
        </div>
      </div>
      <div class="md:col-span-5">
        <div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
          <img src="https://picsum.photos/seed/ogi-cafe-jambi/800/600" alt="Suasana OGI Cafe and Eatery Jambi" width="800" height="600" loading="eager" fetchpriority="high" class="w-full aspect-[4/3] object-cover" />
          <div class="p-8">
            <p class="font-semibold text-lg tracking-tight">Parkir luas, cocok keluarga</p>
            <p class="mt-1 text-base text-gray-600">Indoor cozy + outdoor. Weekend ramai — reservasi H-1 untuk grup &gt;6 orang.</p>
          </div>
        </div>
        <p class="mt-3 text-xs text-zinc-400">Foto placeholder — ganti foto asli interior & menu.</p>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      <div class="md:col-span-7"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
        <p class="font-semibold text-lg tracking-tight">Menu teruji pengunjung</p>
        <p class="text-base text-gray-600">Chicken Katsu Don, Quesadilla, Matcha Latte. Lihat semua di <a class="underline" href="/menu">E-Menu</a>.</p>
      </div></div>
      <div class="md:col-span-5"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.05)]">
        <p class="font-semibold text-lg tracking-tight">Jam sibuk</p>
        <p class="text-base text-gray-600">12.00–13.30 & 18.30–21.00. Datang sebelum 18.00 atau booking via <a class="underline" href="/reservasi">reservasi</a>.</p>
      </div></div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      {menuGroups[0].items.slice(0, 2).map((m) => (
        <div class="md:col-span-6"><div class="bg-white border border-slate-200/50 rounded-[2.5rem] overflow-hidden">
          <img src={`https://picsum.photos/seed/ogi-${m.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/800/600`} alt={m.name} width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
          <div class="p-6"><p class="font-semibold">{m.name}</p><p class="font-mono-num text-rose-700">{m.price}</p></div>
        </div></div>
      ))}
    </div>
    <p class="mt-4 text-sm text-zinc-500">Harga berlabel Estimasi wajib konfirmasi via WA. <a class="underline text-zinc-900" href="/galeri">Lihat galeri</a></p>
  </section>
</BaseLayout>
