---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfoStrip from '../components/InfoStrip.astro';
import DishCard from '../components/DishCard.astro';
import StepsReservasi from '../components/StepsReservasi.astro';
import ReviewMaps from '../components/ReviewMaps.astro';
import Faq from '../components/Faq.astro';
import { business, menuGroups, waLink } from '../data/business';
const seedFor = (n: string) => `ogi-${n.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const highlights = [
  { ...menuGroups[0].items[0] }, { ...menuGroups[0].items[1] },
  { ...menuGroups[0].items[2] }, { ...menuGroups[1].items[0] },
];
const suasana = [
  { seed: 'ogi-interior-1', alt: 'Area indoor cozy OGI Cafe', cap: 'Indoor cozy — AC + colokan' },
  { seed: 'ogi-outdoor-1', alt: 'Area outdoor OGI Cafe malam hari', cap: 'Outdoor — nongkrong malam' },
  { seed: 'ogi-spot-1', alt: 'Spot foto instagramable OGI Cafe', cap: 'Spot foto — ganti foto asli' },
  { seed: 'ogi-group-1', alt: 'Area grup dan parkir luas OGI', cap: 'Area grup + parkir luas' },
];
const quotes = [
  { q: 'Tempatnya cozy, matcha latte-nya juara. Parkir luas jadi gampang bawa keluarga.', by: 'Pengunjung — Danau Sipin' },
  { q: 'Chicken katsu don porsinya pas, quesadilla-nya juga enak. Malam minggu ramai.', by: 'Pengunjung — Kota Jambi' },
  { q: 'Board games + spot foto bikin betah. Booking H-1 via WA dibalas cepat.', by: 'Pengunjung — grup nongkrong' },
];
const faqs = [
  { q: 'Kapan jam paling sibuk?', a: 'Padat jam 12.00–13.30 dan 18.30–21.00. Datang sebelum jam 18.00 atau reservasi H-1 untuk malam minggu.' },
  { q: 'Apakah parkir luas?', a: 'Ya — area parkir lega untuk motor dan mobil, aman untuk rombongan keluarga dan komunitas.' },
  { q: 'Bisa untuk grup besar?', a: 'Bisa. Grup di atas 6 orang wajib reservasi H-1 via WhatsApp 0822-8052-3250 agar meja disiapkan.' },
  { q: 'Bagaimana pembayarannya?', a: 'Bayar di tempat (tunai/transfer/QRIS — konfirmasi ke admin). Item berlabel Estimasi wajib konfirmasi harga via WA.' },
];
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout title="OGI Cafe Jambi Danau Sipin — Basecamp Nongkrong & E-Menu" description="OGI Cafe and Eatery Danau Sipin Jambi rating 4.8 (670 ulasan): basecamp nongkrong anak muda, menu Nusantara–Western–Jepang Rp50–75rb, parkir luas, reservasi 0822-8052-3250." canonicalPath="/" image={business.ogImage}>
  <!-- Ref: Awwwards GEM homepage hero + Plerdy 2025 nav/CTA jelas -->
  <!-- 01 HERO -->
  <section class="max-w-6xl mx-auto px-4 w-full">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center py-12 md:py-16">
      <div class="md:col-span-7 reveal min-w-0">
        <p class="flex flex-wrap items-center gap-2 text-sm font-medium text-orange-800">
          <svg width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M128 16l36 74 82 12-59 58 14 82-73-38-73 38 14-82-59-58 82-12z"/></svg>
          <span class="font-mono-num">4.8 (670 ulasan)</span>
          <span class="text-stone-500">&bull; Danau Sipin &bull; Rp50&ndash;75rb/orang</span>
        </p>
        <h1 class="mt-4 text-4xl md:text-6xl tracking-tight leading-[1.02] font-extrabold">OGI Cafe &mdash; basecamp nongkrong anak Danau Sipin</h1>
        <p class="mt-5 text-base text-stone-600 leading-relaxed max-w-[65ch]">Jl. Empu Sendok No.54, Solok Sipin — indoor cozy, outdoor buat begadang santai, board games, menu Nusantara&ndash;Western&ndash;Jepang. {business.hours}.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href="/menu" class="text-center bg-orange-800 text-orange-50 px-7 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-semibold hover:-translate-y-0.5 active:scale-[0.97] transition">Lihat Menu</a>
          <a href="/reservasi" class="text-center border border-stone-300 px-7 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-semibold hover:border-orange-800 hover:text-orange-800 active:scale-[0.97] transition">Reservasi</a>
        </div>
      </div>
      <div class="md:col-span-5 reveal min-w-0">
        <!-- PERF: hero eager + fetchpriority + srcset/sizes -->
        <img src="https://picsum.photos/seed/ogi-cafe-jambi/800/600" srcset="https://picsum.photos/seed/ogi-cafe-jambi/400/300 400w, https://picsum.photos/seed/ogi-cafe-jambi/800/600 800w" sizes="100vw" alt="Suasana nongkrong OGI Cafe and Eatery Jambi" width="800" height="600" decoding="async" loading="eager" fetchpriority="high" class="photo-fade w-full aspect-[4/3] object-cover rounded-3xl" />
        <p class="mt-2 text-xs text-stone-400">Foto placeholder &mdash; ganti foto asli interior &amp; menu berizin.</p>
      </div>
    </div>
  </section>

  <!-- 02 INFO STRIP -->
  <div class="py-6 md:py-8"><InfoStrip waHref={waLink(`Halo ${business.name}, saya mau reservasi meja.`)} /></div>

  <!-- Ref: Themetags — menu highlight visual -->
  <!-- 03 MENU HIGHLIGHTS -->
  <section aria-label="Menu andalan" class="max-w-6xl mx-auto px-4 py-12 md:py-16">
    <div class="flex items-end justify-between gap-4 min-w-0">
      <div class="min-w-0">
        <p class="text-sm font-semibold text-orange-800">Menu highlights</p>
        <h2 class="mt-2 text-3xl md:text-4xl tracking-tight leading-none font-extrabold">Paling sering dipesan</h2>
      </div>
      <a href="/menu" class="shrink-0 text-sm font-medium underline underline-offset-4 decoration-orange-800 min-h-[48px] inline-flex items-center">E-menu penuh</a>
    </div>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-5">
      {highlights.map((m, i) => (
        <DishCard name={m.name} price={m.price} badge={m.badge} desc={m.desc} seed={seedFor(m.name)} eager={i === 0} waHref={waLink(`Halo ${business.name}, saya mau pesan ${m.name} (${m.price}). Apakah tersedia?`)} />
      ))}
    </div>
  </section>

  <!-- 04 SUASANA -->
  <section aria-label="Suasana" class="max-w-6xl mx-auto px-4 py-12 md:py-16">
    <p class="text-sm font-semibold text-orange-800">Suasana</p>
    <h2 class="mt-2 text-3xl md:text-4xl tracking-tight leading-none font-extrabold">Indoor cozy, outdoor santai, parkir lega</h2>
    <p class="mt-3 text-base text-stone-600 max-w-[65ch]">Indoor ber-AC, outdoor untuk malam minggu, rooftop/spot foto, dan parkir luas untuk rombongan.</p>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-5">
      {suasana.map((s, i) => (
        <figure class="min-w-0">
          <img src={`https://picsum.photos/seed/${s.seed}/800/450`} srcset={`https://picsum.photos/seed/${s.seed}/400/225 400w, https://picsum.photos/seed/${s.seed}/800/450 800w`} sizes="(max-width: 640px) 100vw, 50vw" alt={s.alt} width="800" height="450" decoding="async" loading="lazy" class="w-full aspect-video object-cover rounded-3xl" />
          <figcaption class="mt-2 text-sm text-stone-500">{s.cap}{i === 0 ? ' — foto placeholder, ganti foto asli' : ''}</figcaption>
        </figure>
      ))}
    </div>
    <a href="/galeri" class="mt-5 inline-flex items-center underline underline-offset-4 decoration-orange-800 text-sm font-medium min-h-[48px]">Lihat galeri lengkap</a>
  </section>

  <!-- 05 CARA RESERVASI -->
  <div class="py-12 md:py-16 border-t border-orange-800/10"><StepsReservasi /></div>

  <!-- 06 REVIEWS + MAPS -->
  <div class="py-12 md:py-16 border-t border-orange-800/10"><ReviewMaps quotes={quotes} /></div>

  <!-- 07 FAQ + FINAL CTA -->
  <section aria-label="FAQ dan reservasi" class="max-w-6xl mx-auto px-4 py-12 md:py-16 border-t border-orange-800/10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-7 min-w-0">
        <p class="text-sm font-semibold text-orange-800">FAQ</p>
        <h2 class="mt-2 text-3xl md:text-4xl tracking-tight leading-none font-extrabold">Sering ditanyakan</h2>
        <div class="mt-5"><Faq faqs={faqs} /></div>
      </div>
      <div class="md:col-span-5">
        <div class="bg-orange-800 text-orange-50 rounded-3xl p-8 md:p-10 md:sticky md:top-24">
          <h2 class="text-2xl md:text-3xl tracking-tight font-extrabold leading-tight">Malam minggu penuh? Booking dulu, nongkrong tenang.</h2>
          <p class="mt-2 text-orange-100/90 text-sm">Isi form 1 menit, pesan terkirim rapi ke WhatsApp admin.</p>
          <div class="mt-6 flex flex-col gap-3">
            <a href="/reservasi" class="text-center bg-orange-50 text-orange-800 px-8 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-bold active:scale-[0.97] transition">Reservasi meja</a>
            <a href="/menu" class="text-center border border-orange-50/40 px-8 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-semibold hover:bg-orange-50/10 transition">Lihat menu dulu</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</BaseLayout>
