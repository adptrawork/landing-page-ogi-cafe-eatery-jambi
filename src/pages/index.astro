---
import BaseLayout from '../layouts/BaseLayout.astro';
import InfoStrip from '../components/InfoStrip.astro';
import MenuJournal from '../components/MenuJournal.astro';
import StepsReservasi from '../components/StepsReservasi.astro';
import ReviewMaps from '../components/ReviewMaps.astro';
import Faq from '../components/Faq.astro';
import { business, waLink } from '../data/business';
import { menuItems, categoryCounts, photos } from '../data/menu-journal';

const waRes = waLink(`Halo ${business.name}, saya mau reservasi meja.`);
const busy = [
  { k: 'Makan siang', v: '12.00–13.30 WIB', note: 'Antrean tercepat sebelum 12.00' },
  { k: 'Makan malam', v: '18.30–21.00 WIB', note: 'Malam minggu reservasi H-1' },
  { k: 'Sepi & santai', v: '14.00–17.00 WIB', note: 'Waktu enak buat kerja / ngobrol' },
];
const faqs = [
  { q: 'Bagaimana label Teruji dan Estimasi di menu?', a: 'Teruji berarti item disebut di review pengunjung. Estimasi berarti harga belum terkonfirmasi dan wajib dicek via WhatsApp 0822-8052-3250 sebelum memesan.' },
  { q: 'Kapan jam paling ramai di OGI?', a: 'Padat sekitar 12.00–13.30 dan 18.30–21.00 WIB. Datang sebelum jam 18.00 atau reservasi H-1 untuk malam minggu.' },
  { q: 'Bisa untuk grup besar?', a: 'Bisa. Grup di atas 6 orang sebaiknya reservasi H-1 via WhatsApp agar meja disiapkan.' },
  { q: 'Bagaimana pembayarannya?', a: 'Bayar di tempat (tunai/transfer/QRIS — konfirmasi ke admin saat berkunjung).' },
];
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout title="OGI Cafe Jambi Danau Sipin — E-Menu & Reservasi Meja" description="OGI Cafe and Eatery Danau Sipin Jambi rating 4.8 (670 ulasan): menu Nusantara–Western–Jepang, kisaran Rp50–75rb/orang, parkir luas, reservasi 0822-8052-3250." canonicalPath="/">
  <!-- Ref: menu journal/food editorial — hero editorial asimetris (narasi kiri, foto kanan), bukan hero tengah -->
  <!-- 01 HERO -->
  <section class="max-w-6xl mx-auto px-4 w-full pt-10 md:pt-16 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
      <div class="md:col-span-7 min-w-0 md:pt-4">
        <p class="reveal flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] font-semibold tracking-[0.18em] uppercase text-olive" style="--i:0">
          <span>OGI Cafe &amp; Eatery</span>
          <span class="text-olive/40" aria-hidden="true">&bull;</span>
          <span>Danau Sipin, Kota Jambi</span>
        </p>
        <h1 class="reveal mt-5 font-display text-4xl sm:text-5xl md:text-6xl font-semibold leading-[1.02] tracking-tight max-w-[15ch]" style="--i:1">
          Catatan rasa dari dapur kami di tepi Danau Sipin
        </h1>
        <p class="reveal mt-6 text-base md:text-lg leading-relaxed text-ink/80 max-w-[58ch]" style="--i:2">
          Menu Nusantara, Western, dan Jepang, plus kopi, teh, dan dessert. Indoor ber-AC, teras outdoor untuk malam,
          dan parkir lega untuk rombongan. {business.hours}.
        </p>
        <div class="reveal mt-8 grid sm:flex gap-3" style="--i:3">
          <a href="/menu" class="text-center bg-accent text-paper px-7 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-semibold hover:opacity-90 active:scale-[0.98] transition">Buka e-menu</a>
          <a href="/reservasi" class="text-center border border-ink/30 px-7 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-semibold text-ink hover:border-accent hover:text-accent active:scale-[0.98] transition">Reservasi meja</a>
        </div>
        <p class="reveal mt-5 text-sm text-ink-muted" style="--i:4">
          <span class="font-mono-num font-semibold text-ink">{business.rating}</span> dari 5 &middot; {business.reviewCount} ulasan Google &middot; {business.priceRange}
        </p>
      </div>
      <figure class="reveal md:col-span-5 min-w-0 md:mt-10 relative" style="--i:2">
        <div class="absolute -inset-x-3 -inset-y-3 md:-inset-x-4 md:-inset-y-4 bg-paper-2 rounded-[2rem] -z-10" aria-hidden="true"></div>
        <!-- PERF: hero eager + fetchpriority -->
        <img
          src={photos.suasa.src}
          alt={photos.suasa.alt}
          width={photos.suasa.w}
          height={photos.suasa.h}
          decoding="async"
          loading="eager"
          fetchpriority="high"
          class="photo-fade w-full aspect-[4/3] object-cover rounded-[1.5rem]"
        />
        <figcaption class="mt-3 text-xs leading-relaxed text-ink-muted">Ilustrasi suasana makan, bukan foto lokasi OGI. Kredit: Wikimedia Commons.</figcaption>
      </figure>
    </div>
  </section>

  <!-- 02 INFO KUNJUNGAN -->
  <div class="max-w-6xl mx-auto px-4 py-6 md:py-8">
    <InfoStrip waHref={waRes} />
  </div>

  <!-- Ref: menu journal/food editorial — filter kategori + daftar menu dua kolom seperti menu cetak -->
  <!-- 03 MENU JOURNAL (filter + dua kolom) -->
  <section aria-label="E-menu" class="max-w-6xl mx-auto px-4 py-12 md:py-20 border-t border-olive/25">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-end">
      <div class="md:col-span-8 min-w-0">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-olive">E-menu &middot; <span class="font-mono-num">{menuItems.length} item</span></p>
        <h2 class="mt-3 font-display text-3xl md:text-5xl font-semibold tracking-tight leading-[1.05]">Satu halaman untuk makan, minum, kopi, dan dessert</h2>
      </div>
      <p class="md:col-span-4 md:text-right text-sm leading-relaxed text-ink-muted">
        Harga bersumber arsip 2023. Label <strong class="text-ink">Teruji</strong> dan <strong class="text-ink">Estimasi</strong> wajib dikonfirmasi via WhatsApp sebelum memesan.
      </p>
    </div>
    <div class="mt-8">
      <MenuJournal items={menuItems} />
    </div>
    <a href="/menu" class="mt-8 inline-flex items-center gap-2 font-semibold text-accent underline underline-offset-4 decoration-accent/40 min-h-[44px]">
      Buka halaman e-menu lengkap
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </section>

  <!-- Ref: editorial zig-zag — blok narasi dua kolom + foto lokal bergantian -->
  <!-- 04 CERITA SUASANA -->
  <section aria-label="Suasana" class="max-w-6xl mx-auto px-4 py-12 md:py-20 border-t border-olive/25">
    <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-olive">Cerita suasana</p>
    <h2 class="mt-3 font-display text-3xl md:text-4xl font-semibold tracking-tight leading-[1.08] max-w-[24ch]">Meja panjang, cahaya hangat, obrolan yang betah</h2>

    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-14 items-center">
      <div class="min-w-0">
        <h3 class="font-display text-2xl font-semibold tracking-tight">Ruang dalam yang tenang</h3>
        <p class="mt-3 text-[15px] leading-relaxed text-ink/75 max-w-[52ch]">
          Bagian indoor ber-AC dengan meja berjarak — nyaman untuk makan siang kerja, rapat kecil, atau sekadar
          ngopi sambil membuka laptop. Furnitur kayu dan warna earthy menjaga ruang terasa hangat, bukan ramai.
        </p>
      </div>
      <figure class="min-w-0">
        <img src={photos.interior.src} alt={photos.interior.alt} width={photos.interior.w} height={photos.interior.h} decoding="async" loading="lazy" class="w-full aspect-[4/3] object-cover rounded-3xl" />
        <figcaption class="mt-2 text-xs text-ink-muted">Ilustrasi ruang kafe, bukan foto lokasi OGI.</figcaption>
      </figure>
    </div>

    <div class="mt-12 md:mt-16 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-14 items-center">
      <figure class="min-w-0 md:order-1">
        <img src={photos.outdoor.src} alt={photos.outdoor.alt} width={photos.outdoor.w} height={photos.outdoor.h} decoding="async" loading="lazy" class="w-full aspect-[4/3] object-cover rounded-3xl" />
        <figcaption class="mt-2 text-xs text-ink-muted">Ilustrasi teras kafe, bukan foto lokasi OGI.</figcaption>
      </figure>
      <div class="min-w-0 md:order-2">
        <h3 class="font-display text-2xl font-semibold tracking-tight">Teras untuk malam minggu</h3>
        <p class="mt-3 text-[15px] leading-relaxed text-ink/75 max-w-[52ch]">
          Teras outdoor jadi pilihan saat matahari turun. Cocok untuk ngobrol lama, kumpul komunitas, atau makan
          bareng keluarga besar. Untuk grup di atas 6 orang, amankan meja lewat reservasi H-1.
        </p>
        <a href="/galeri" class="mt-5 inline-flex items-center gap-2 font-semibold text-accent underline underline-offset-4 decoration-accent/40 min-h-[44px]">
          Lihat galeri suasana
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Ref: highlight ber-rule — kategori & jam ramai sebagai daftar, bukan kartu -->
  <!-- 05 KATEGORI & JAM RAMAI -->
  <section aria-label="Kategori dan jam ramai" class="max-w-6xl mx-auto px-4 py-12 md:py-20 border-t border-olive/25">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16">
      <div class="min-w-0">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-olive">Kategori menu</p>
        <h2 class="mt-3 font-display text-2xl md:text-3xl font-semibold tracking-tight">Apa yang mau kamu cari?</h2>
        <ul class="mt-6 divide-y divide-olive/25 border-t border-olive/30">
          {categoryCounts.map((c) => (
            <li class="grid grid-cols-[1fr_auto] items-baseline gap-4 py-4">
              <a href={`/menu#menu-journal`} class="font-display text-lg font-semibold tracking-tight text-ink hover:text-accent transition-colors">{c.label}</a>
              <span class="font-mono-num text-sm text-ink-muted">{String(c.count).padStart(2, '0')} item</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="min-w-0">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-olive">Jam ramai</p>
        <h2 class="mt-3 font-display text-2xl md:text-3xl font-semibold tracking-tight">Pilih waktu kunjunganmu</h2>
        <dl class="mt-6 divide-y divide-olive/25 border-t border-olive/30">
          {busy.map((b) => (
            <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-1 sm:gap-4 py-4">
              <dt class="font-semibold text-[15px]">{b.k} <span class="block text-sm font-normal text-ink-muted">{b.note}</span></dt>
              <dd class="font-mono-num text-sm text-accent sm:text-right">{b.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- 06 LOKASI (MapFacade + CTA reservasi) -->
  <div class="max-w-6xl mx-auto px-4 py-12 md:py-20 border-t border-olive/25">
    <ReviewMaps />
  </div>

  <!-- Ref: menu journal — alur reservasi + FAQ penutup -->
  <!-- 07 CARA RESERVASI + FAQ -->
  <div class="max-w-6xl mx-auto px-4 py-12 md:py-20 border-t border-olive/25">
    <StepsReservasi />
  </div>

  <section aria-label="FAQ" class="max-w-6xl mx-auto px-4 py-12 md:py-20 border-t border-olive/25">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
      <div class="md:col-span-5 min-w-0">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-olive">FAQ</p>
        <h2 class="mt-3 font-display text-3xl md:text-4xl font-semibold tracking-tight leading-[1.05]">Pertanyaan yang sering muncul</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-ink/75">Belum terjawab? Chat admin lewat WhatsApp, dibalas cepat saat jam buka.</p>
      </div>
      <div class="md:col-span-7 min-w-0">
        <Faq faqs={faqs} />
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</BaseLayout>
