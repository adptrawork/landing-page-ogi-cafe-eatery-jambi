---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, waLink } from '../data/business';
---
<BaseLayout title={`Reservasi ${business.name} — Booking Meja via WA`} description={`Reservasi meja ${business.name} Jl Empu Sendok Jambi. Isi form lalu kirim via WhatsApp ${business.phone}. Grup >6 orang disarankan H-1.`} canonicalPath="/reservasi">
  <section class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-7">
        <p class="text-sm font-medium text-rose-700">Reservasi</p>
        <h1 class="mt-2 text-4xl md:text-6xl tracking-tighter leading-none font-bold">Booking Meja OGI</h1>
        <p class="mt-3 text-base text-gray-600 max-w-[65ch]">Isi form, tekan kirim — pesan terformat rapi terbuka di WhatsApp {business.phone}. Tanpa akun, tanpa antre telepon.</p>
        <form id="book" class="mt-8 bg-white border border-slate-200/50 rounded-[2.5rem] p-8 space-y-4">
          <div><label for="nama" class="text-sm font-medium">Nama</label><input id="nama" required placeholder="Nama kamu" class="mt-1 w-full border rounded-2xl px-4 py-3 min-h-[48px]" /><p class="text-xs text-zinc-500 mt-1">Wajib diisi.</p></div>
          <div class="grid md:grid-cols-2 gap-4">
            <div><label for="tgl" class="text-sm font-medium">Tanggal</label><input id="tgl" type="date" required class="mt-1 w-full border rounded-2xl px-4 py-3 min-h-[48px]" /><p class="text-xs text-zinc-500 mt-1">Minimal hari ini.</p></div>
            <div><label for="jam" class="text-sm font-medium">Jam</label><input id="jam" type="time" required class="mt-1 w-full border rounded-2xl px-4 py-3 min-h-[48px]" /><p class="text-xs text-zinc-500 mt-1">Lihat jam buka di bawah.</p></div>
          </div>
          <div><label for="pax" class="text-sm font-medium">Jumlah orang</label><input id="pax" type="number" min="1" max="120" value="2" required class="mt-1 w-full border rounded-2xl px-4 py-3 min-h-[48px]" /><p id="err" class="hidden text-sm text-red-600 mt-1">Jumlah minimal 1 orang.</p></div>
          <div><label for="cat" class="text-sm font-medium">Catatan (opsional)</label><input id="cat" placeholder="Area indoor / ultah / kursi bayi" class="mt-1 w-full border rounded-2xl px-4 py-3 min-h-[48px]" /></div>
          <button class="bg-rose-700 text-white px-7 py-3.5 rounded-full font-medium active:scale-[0.98]">Kirim via WhatsApp</button>
        </form>
      </div>
      <div class="md:col-span-5">
        <div class="bg-white border border-slate-200/50 rounded-[2.5rem] p-8">
          <p class="font-semibold">Info kunjungan</p>
          <p class="mt-2 text-sm text-gray-600">{business.address}</p>
          <p class="mt-1 text-sm text-gray-600">{business.hours}</p>
          <p class="mt-1 text-sm text-gray-600">Telepon/WA: {business.phone}</p>
          <p class="mt-3 text-sm text-gray-600">Sibuk 12.00–13.30 & 18.30–21.00. Grup &gt;6 orang reservasi H-1.</p>
          <a class="mt-4 inline-block underline" href={business.mapsUrl}>Rute ke lokasi</a>
        </div>
      </div>
    </div>
  </section>
<script is:inline>
document.getElementById('book').addEventListener('submit', function(e) {
  e.preventDefault();
  var nama = document.getElementById('nama').value.trim();
  var tgl = document.getElementById('tgl').value;
  var jam = document.getElementById('jam').value;
  var pax = parseInt(document.getElementById('pax').value, 10);
  var cat = document.getElementById('cat').value.trim();
  var err = document.getElementById('err');
  if (!nama || !tgl || !jam || !(pax >= 1)) { err.classList.remove('hidden'); return; }
  err.classList.add('hidden');
  var today = new Date().toISOString().slice(0,10);
  if (tgl < today) { err.textContent = 'Tanggal tidak boleh lampau.'; err.classList.remove('hidden'); return; }
  var msg = 'Halo OGI Cafe and Eatery, saya mau reservasi meja. Nama: ' + nama + '. Tanggal: ' + tgl + ' jam ' + jam + '. Jumlah: ' + pax + ' orang.' + (cat ? ' Catatan: ' + cat : '');
  window.open('https://wa.me/6282280523250?text=' + encodeURIComponent(msg), '_blank');
});
</script>
</BaseLayout>
