---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import { business } from '../data/business';
const faqs = [
  { q: 'Perlu reservasi atau bisa walk-in?', a: 'Bisa walk-in di jam sepi. Grup di atas 6 orang atau malam minggu: reservasi H-1 via WhatsApp 0822-8052-3250.' },
  { q: 'Bagaimana cara booking meja?', a: 'Isi form di halaman ini lalu tekan kirim — pesan terformat rapi otomatis terbuka di WhatsApp admin. Tanpa akun.' },
  { q: 'Kapan jam paling ramai?', a: 'Padat 12.00–13.30 dan 18.30–21.00. Datang sebelum jam 18.00 atau booking slot malam lebih aman.' },
  { q: 'Apakah harga menu pasti?', a: 'Item Teruji disebut di review. Item Estimasi wajib konfirmasi ulang via WA karena bisa berubah.' },
];
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout title="Reservasi OGI Cafe Jambi — Booking Meja via WA" description="Booking meja OGI Cafe Jl Empu Sendok Danau Sipin Jambi: isi form 1 menit, terkirim via WhatsApp 0822-8052-3250. Grup >6 orang disarankan H-1." canonicalPath="/reservasi">
  <section class="max-w-6xl mx-auto px-4 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      <div class="md:col-span-7 min-w-0">
        <p class="text-sm font-semibold text-orange-800">Reservasi &bull; tanpa akun</p>
        <h1 class="mt-2 text-4xl md:text-6xl tracking-tight leading-[1.02] font-extrabold">Amankan mejamu malam ini</h1>
        <p class="mt-3 text-base text-stone-600 max-w-[65ch]">Isi form, tekan kirim &mdash; pesan terformat rapi terbuka di WhatsApp 0822-8052-3250.</p>
        <!-- Ref: form 48px + error di bawah input + helper -->
        <form id="book" class="mt-8 border border-orange-800/15 rounded-3xl p-6 md:p-8 space-y-5 bg-white/60" novalidate>
          <div>
            <label for="nama" class="text-sm font-semibold">Nama</label>
            <input id="nama" name="nama" required placeholder="Nama kamu" autocomplete="name" class="mt-1 w-full border border-stone-300 rounded-2xl px-4 py-3 min-h-[48px] bg-white focus:border-orange-800 focus:outline-none" />
            <p class="text-xs text-stone-500 mt-1">Wajib diisi — nama pemesan meja.</p>
            <p data-err="nama" class="hidden text-sm text-red-700 mt-1 font-medium">Isi nama dulu ya.</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="tgl" class="text-sm font-semibold">Tanggal</label>
              <input id="tgl" name="tgl" type="date" required class="mt-1 w-full border border-stone-300 rounded-2xl px-4 py-3 min-h-[48px] bg-white focus:border-orange-800 focus:outline-none" />
              <p class="text-xs text-stone-500 mt-1">Minimal hari ini.</p>
              <p data-err="tgl" class="hidden text-sm text-red-700 mt-1 font-medium">Pilih tanggal hari ini atau sesudahnya.</p>
            </div>
            <div>
              <label for="jam" class="text-sm font-semibold">Jam</label>
              <input id="jam" name="jam" type="time" required class="mt-1 w-full border border-stone-300 rounded-2xl px-4 py-3 min-h-[48px] bg-white focus:border-orange-800 focus:outline-none" />
              <p class="text-xs text-stone-500 mt-1">Lihat jam buka di samping.</p>
              <p data-err="jam" class="hidden text-sm text-red-700 mt-1 font-medium">Pilih jam kedatangan.</p>
            </div>
          </div>
          <div>
            <label for="pax" class="text-sm font-semibold">Jumlah orang</label>
            <input id="pax" name="pax" type="number" min="1" max="120" value="2" required inputmode="numeric" class="mt-1 w-full border border-stone-300 rounded-2xl px-4 py-3 min-h-[48px] bg-white focus:border-orange-800 focus:outline-none" />
            <p class="text-xs text-stone-500 mt-1">Grup &gt;6 orang disarankan H-1.</p>
            <p data-err="pax" class="hidden text-sm text-red-700 mt-1 font-medium">Jumlah minimal 1 orang.</p>
          </div>
          <div>
            <label for="cat" class="text-sm font-semibold">Catatan (opsional)</label>
            <input id="cat" name="cat" placeholder="Area indoor / ultah / kursi bayi" class="mt-1 w-full border border-stone-300 rounded-2xl px-4 py-3 min-h-[48px] bg-white focus:border-orange-800 focus:outline-none" />
            <p class="text-xs text-stone-500 mt-1">Contoh: area indoor, bawa anak kecil.</p>
          </div>
          <button type="submit" class="w-full sm:w-auto bg-orange-800 text-orange-50 px-7 py-3.5 min-h-[48px] rounded-full font-bold hover:-translate-y-0.5 active:scale-[0.97] transition">Kirim via WhatsApp</button>
        </form>
      </div>
      <div class="md:col-span-5 min-w-0">
        <div class="border border-orange-800/15 rounded-3xl p-6 md:p-8 bg-orange-800/[0.05] md:sticky md:top-24">
          <p class="font-bold">Info kunjungan</p>
          <p class="mt-2 text-sm text-stone-600">{business.address}</p>
          <p class="mt-1 text-sm text-stone-600">{business.hours}</p>
          <p class="mt-1 font-mono-num text-sm font-semibold text-orange-800">0822-8052-3250</p>
          <p class="mt-3 text-sm text-stone-600">Sibuk 12.00&ndash;13.30 &amp; 18.30&ndash;21.00. Grup &gt;6 orang reservasi H-1.</p>
          <a class="mt-4 inline-flex items-center underline underline-offset-4 decoration-orange-800 text-sm font-medium min-h-[48px]" href={business.mapsUrl} target="_blank" rel="noopener">Rute ke lokasi</a>
        </div>
        <div class="mt-6">
          <h2 class="font-bold text-lg tracking-tight">Tanya jawab reservasi</h2>
          <div class="mt-3"><Faq faqs={faqs} /></div>
        </div>
      </div>
    </div>
  </section>
<script is:inline>
(function () {
  var form = document.getElementById('book');
  if (!form) return;
  function err(n, on, msg) {
    var p = form.querySelector('[data-err="' + n + '"]');
    if (!p) return;
    if (msg) p.textContent = msg;
    p.classList.toggle('hidden', !on);
  }
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var nama = document.getElementById('nama').value.trim();
    var tgl = document.getElementById('tgl').value;
    var jam = document.getElementById('jam').value;
    var pax = parseInt(document.getElementById('pax').value, 10);
    var cat = document.getElementById('cat').value.trim();
    var ok = true;
    if (!nama) { err('nama', true); ok = false; } else err('nama', false);
    var today = new Date().toISOString().slice(0, 10);
    if (!tgl || tgl < today) { err('tgl', true); ok = false; } else err('tgl', false);
    if (!jam) { err('jam', true); ok = false; } else err('jam', false);
    if (!(pax >= 1)) { err('pax', true); ok = false; } else err('pax', false);
    if (!ok) return;
    var msg = 'Halo OGI Cafe and Eatery, saya mau reservasi meja. Nama: ' + nama + '. Tanggal: ' + tgl + ' jam ' + jam + '. Jumlah: ' + pax + ' orang.' + (cat ? ' Catatan: ' + cat : '');
    window.open('https://wa.me/6282280523250?text=' + encodeURIComponent(msg), '_blank');
  });
})();
</script>
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</BaseLayout>
