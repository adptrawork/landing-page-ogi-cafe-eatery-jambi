---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import { business } from '../data/business';
const faqs = [
  { q: 'Perlu reservasi atau bisa langsung datang?', a: 'Bisa langsung datang di jam sepi. Untuk grup di atas 6 orang atau malam minggu, reservasi H-1 via WhatsApp 0822-8052-3250.' },
  { q: 'Bagaimana cara booking meja?', a: 'Isi form di halaman ini lalu tekan kirim — pesan terformat rapi otomatis terbuka di WhatsApp admin. Tanpa akun.' },
  { q: 'Kapan jam paling ramai?', a: 'Padat sekitar 12.00–13.30 dan 18.30–21.00 WIB. Datang sebelum jam 18.00 atau booking slot malam lebih aman.' },
  { q: 'Apakah harga menu pasti?', a: 'Item Teruji disebut di review pengunjung. Item Estimasi harga arsip 2023 — konfirmasi ulang via WhatsApp karena bisa berubah.' },
];
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://ogicafe-jambi.pages.dev/' },
    { '@type': 'ListItem', position: 2, name: 'Reservasi', item: 'https://ogicafe-jambi.pages.dev/reservasi' },
  ],
};
const inputCls = 'mt-1.5 w-full border border-olive/40 rounded-2xl px-4 py-3 min-h-[48px] bg-paper text-ink placeholder:text-ink/40 focus:border-accent focus:outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent transition-colors';
const labelCls = 'text-sm font-semibold text-ink';
---
<BaseLayout title="Reservasi OGI Cafe Jambi — Booking Meja via WhatsApp" description="Booking meja OGI Cafe Jl. Empu Sendok, Danau Sipin, Jambi: isi form satu menit, pesan terkirim via WhatsApp 0822-8052-3250. Grup di atas 6 orang disarankan H-1." canonicalPath="/reservasi">
  <!-- Ref: menu journal — hero editorial asimetris, form di kolom kiri -->
  <!-- 01 HERO + FORM -->
  <section class="max-w-6xl mx-auto px-4 w-full pt-10 md:pt-16 pb-6">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
      <div class="md:col-span-7 min-w-0">
        <p class="reveal text-[11px] font-semibold tracking-[0.18em] uppercase text-olive" style="--i:0">Reservasi &middot; tanpa akun</p>
        <h1 class="reveal mt-5 font-display text-4xl sm:text-5xl md:text-6xl font-semibold leading-[1.02] tracking-tight max-w-[15ch]" style="--i:1">
          Amankan mejamu sebelum malam ramai
        </h1>
        <p class="reveal mt-6 text-base md:text-lg leading-relaxed text-ink/80 max-w-[56ch]" style="--i:2">
          Isi form singkat, tekan kirim — pesan terformat rapi langsung terbuka di WhatsApp 0822-8052-3250. Admin mengonfirmasi slot dan menyiapkan meja.
        </p>

        <!-- Ref: form 48px, error di bawah input, helper text -->
        <form id="book" class="mt-8 border border-olive/30 rounded-3xl p-6 md:p-8 grid gap-5 bg-paper-2/40" novalidate>
          <div>
            <label for="nama" class={labelCls}>Nama</label>
            <input id="nama" name="nama" required placeholder="Nama pemesan" autocomplete="name" class={inputCls} />
            <p class="text-xs text-ink-muted mt-1.5">Wajib diisi — nama yang memesan meja.</p>
            <p data-err="nama" class="hidden text-sm text-accent mt-1.5 font-semibold">Isi nama dulu ya.</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="tgl" class={labelCls}>Tanggal</label>
              <input id="tgl" name="tgl" type="date" required class={inputCls} />
              <p class="text-xs text-ink-muted mt-1.5">Minimal hari ini.</p>
              <p data-err="tgl" class="hidden text-sm text-accent mt-1.5 font-semibold">Pilih tanggal hari ini atau sesudahnya.</p>
            </div>
            <div>
              <label for="jam" class={labelCls}>Jam</label>
              <input id="jam" name="jam" type="time" required class={inputCls} />
              <p class="text-xs text-ink-muted mt-1.5">Cek jam buka di panel kanan.</p>
              <p data-err="jam" class="hidden text-sm text-accent mt-1.5 font-semibold">Pilih jam kedatangan.</p>
            </div>
          </div>
          <div>
            <label for="pax" class={labelCls}>Jumlah orang</label>
            <input id="pax" name="pax" type="number" min="1" max="120" value="2" required inputmode="numeric" class={inputCls} />
            <p class="text-xs text-ink-muted mt-1.5">Grup di atas 6 orang disarankan reservasi H-1.</p>
            <p data-err="pax" class="hidden text-sm text-accent mt-1.5 font-semibold">Jumlah minimal 1 orang.</p>
          </div>
          <div>
            <label for="cat" class={labelCls}>Catatan (opsional)</label>
            <input id="cat" name="cat" placeholder="Area indoor, ultah, kursi bayi" class={inputCls} />
            <p class="text-xs text-ink-muted mt-1.5">Contoh: area indoor, bawa anak kecil.</p>
          </div>
          <button type="submit" class="w-full sm:w-auto bg-accent text-paper px-7 py-3.5 min-h-[48px] rounded-full font-semibold hover:opacity-90 active:scale-[0.98] transition justify-self-start">Kirim via WhatsApp</button>
        </form>
      </div>

      <div class="md:col-span-5 min-w-0 md:sticky md:top-24">
        <div class="border border-olive/30 rounded-3xl p-6 md:p-8 bg-paper-2/60">
          <p class="text-[11px] font-semibold tracking-[0.16em] uppercase text-olive">Info kunjungan</p>
          <dl class="mt-4 grid gap-3 text-sm">
            <div>
              <dt class="text-ink-muted">Alamat</dt>
              <dd class="mt-0.5 text-[15px] leading-relaxed text-ink">{business.address}</dd>
            </div>
            <div>
              <dt class="text-ink-muted">Jam buka</dt>
              <dd class="mt-0.5 text-[15px] leading-relaxed text-ink">{business.hours}</dd>
            </div>
            <div>
              <dt class="text-ink-muted">WhatsApp</dt>
              <dd class="mt-0.5"><a href={`https://wa.me/${business.phone}`} target="_blank" rel="noopener" class="font-mono-num font-semibold text-accent underline underline-offset-4 decoration-accent/40">0822-8052-3250</a></dd>
            </div>
          </dl>
          <p class="mt-4 text-sm leading-relaxed text-ink/75">Padat 12.00&ndash;13.30 &amp; 18.30&ndash;21.00 WIB. Grup di atas 6 orang sebaiknya reservasi H-1.</p>
          <a href={business.mapsUrl} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-2 text-accent underline underline-offset-4 decoration-accent/40 font-semibold min-h-[44px]">
            Rute ke lokasi
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 FAQ RESERVASI -->
  <section class="max-w-6xl mx-auto px-4 py-12 md:py-16 border-t border-olive/25">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
      <div class="md:col-span-4 min-w-0">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-olive">Tanya jawab</p>
        <h2 class="mt-3 font-display text-3xl md:text-4xl font-semibold tracking-tight leading-[1.05]">Sebelum kamu reservasi</h2>
      </div>
      <div class="md:col-span-8 min-w-0"><Faq faqs={faqs} /></div>
    </div>
  </section>
  <script is:inline>
    /* Validasi form ringan -> buka WhatsApp. Tanpa dependency. */
    (function () {
      var form = document.getElementById('book');
      if (!form) return;
      function err(n, on) {
        var p = form.querySelector('[data-err="' + n + '"]');
        if (p) p.classList.toggle('hidden', !on);
      }
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var nama = document.getElementById('nama').value.trim();
        var tgl = document.getElementById('tgl').value;
        var jam = document.getElementById('jam').value;
        var pax = parseInt(document.getElementById('pax').value, 10);
        var cat = document.getElementById('cat').value.trim();
        var ok = true;
        if (!nama) { err('nama', true); ok = false; } else err('nama', false);
        var today = new Date().toISOString().slice(0, 10);
        if (!tgl || tgl < today) { err('tgl', true); ok = false; } else err('tgl', false);
        if (!jam) { err('jam', true); ok = false; } else err('jam', false);
        if (!(pax >= 1)) { err('pax', true); ok = false; } else err('pax', false);
        if (!ok) return;
        var msg = 'Halo OGI Cafe and Eatery, saya mau reservasi meja. Nama: ' + nama + '. Tanggal: ' + tgl + ' jam ' + jam + '. Jumlah: ' + pax + ' orang.' + (cat ? ' Catatan: ' + cat : '');
        window.open('https://wa.me/6282280523250?text=' + encodeURIComponent(msg), '_blank');
      });
    })();
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</BaseLayout>
