---
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuJournal from '../components/MenuJournal.astro';
import MapFacade from '../components/MapFacade.astro';
import { business, menuGroups, waLink } from '../data/business';
import { menuItems, categoryCounts, photos } from '../data/menu-journal';
const total = menuItems.length;
const waAsk = waLink(`Halo ${business.name}, saya mau tanya menu lengkap hari ini.`);
const menuLd = {
  '@context': 'https://schema.org', '@type': 'Menu', name: `E-Menu ${business.name}`,
  hasMenuSection: menuGroups.map((g) => ({
    '@type': 'MenuSection', name: g.category,
    hasMenuItem: g.items.map((m) => ({ '@type': 'MenuItem', name: m.name, description: m.desc, offers: { '@type': 'Offer', price: m.price } })),
  })),
};
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://ogicafe-jambi.pages.dev/' },
    { '@type': 'ListItem', position: 2, name: 'E-Menu', item: 'https://ogicafe-jambi.pages.dev/menu' },
  ],
};
---
<BaseLayout title="E-Menu OGI Cafe Jambi — Makanan, Kopi & Dessert Danau Sipin" description="E-menu OGI Cafe Jambi: Chicken Katsu Don, Quesadilla, Matcha Latte, Kopi Susu Gula Aren. Label Teruji & Estimasi, cek dulu via WA 0822-8052-3250." canonicalPath="/menu">
  <!-- Ref: menu journal/food editorial — hero editorial asimetris + legenda label -->
  <!-- 01 HERO -->
  <section class="max-w-6xl mx-auto px-4 w-full pt-10 md:pt-16 pb-6">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
      <div class="md:col-span-7 min-w-0 md:pt-4">
        <p class="reveal text-[11px] font-semibold tracking-[0.18em] uppercase text-ink/60" style="--i:0">E-menu &middot; <span class="font-mono-num">{total} item</span> &middot; Kota Jambi</p>
        <h1 class="reveal mt-5 font-display text-4xl sm:text-5xl md:text-6xl font-semibold leading-[1.02] tracking-tight max-w-[16ch]" style="--i:1">
          Menu journal OGI: dari katsu sampai kopi gula aren
        </h1>
        <p class="reveal mt-6 text-base md:text-lg leading-relaxed text-ink/80 max-w-[58ch]" style="--i:2">
          Semua yang bisa kamu pesan, disusun seperti daftar menu cetak — dua kolom, rapi dibaca.
          Gunakan filter untuk menyaring Makanan, Minuman, Kopi, atau Dessert.
        </p>
      </div>
      <div class="reveal md:col-span-5 min-w-0 md:mt-10" style="--i:2">
        <figure>
          <img src={photos.kopi.src} alt={photos.kopi.alt} width={photos.kopi.w} height={photos.kopi.h} decoding="async" loading="lazy" class="w-full aspect-[4/3] object-cover rounded-3xl" />
          <figcaption class="mt-2 text-xs text-ink/60">Ilustrasi secangkir kopi, bukan foto menu OGI.</figcaption>
        </figure>
        <div class="mt-5 border border-ink/30 rounded-2xl bg-ink/8 p-5">
          <p class="text-[11px] font-semibold tracking-[0.16em] uppercase text-ink/60">Cara baca label</p>
          <ul class="mt-3 grid gap-2 text-sm">
            <li class="grid grid-cols-[auto_1fr] items-center gap-3">
              <span class="bg-accent text-paper text-[11px] font-semibold tracking-wide uppercase rounded-full px-3 py-1">Teruji</span>
              <span class="text-ink/80">Disebut di review pengunjung.</span>
            </li>
            <li class="grid grid-cols-[auto_1fr] items-center gap-3">
              <span class="border border-ink/50 text-ink/60 text-[11px] font-semibold tracking-wide uppercase rounded-full px-3 py-1">Estimasi</span>
              <span class="text-ink/80">Harga arsip 2023 — konfirmasi via WA.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Ref: filter kategori interaktif + daftar menu dua kolom seperti menu cetak -->
  <!-- 02 MENU JOURNAL -->
  <section aria-label="Daftar menu" class="max-w-6xl mx-auto px-4 py-10 md:py-16 border-t border-ink/25">
    <MenuJournal items={menuItems} />
  </section>

  <!-- Ref: kategori & jam ramai sebagai list ber-rule (bukan kartu) -->
  <!-- 03 KATEGORI & WAKTU -->
  <section aria-label="Kategori dan waktu kunjungan" class="max-w-6xl mx-auto px-4 py-12 md:py-16 border-t border-ink/25">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16">
      <div class="min-w-0">
        <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-tight">Kategori</h2>
        <ul class="mt-6 divide-y divide-ink/25 border-t border-ink/30">
          {categoryCounts.map((c) => (
            <li class="grid grid-cols-[1fr_auto] items-baseline gap-4 py-4">
              <span class="font-display text-lg font-semibold tracking-tight">{c.label}</span>
              <span class="font-mono-num text-sm text-ink/60">{String(c.count).padStart(2, '0')} item</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="min-w-0">
        <h2 class="font-display text-2xl md:text-3xl font-semibold tracking-tight">Cara pesan</h2>
        <ol class="mt-6 divide-y divide-ink/25 border-t border-ink/30">
          <li class="grid grid-cols-[auto_1fr] gap-4 py-4"><span class="font-mono-num text-sm text-accent pt-1">01</span><p class="text-[15px] leading-relaxed text-ink/80">Saring kategori atau telusuri seluruh daftar.</p></li>
          <li class="grid grid-cols-[auto_1fr] gap-4 py-4"><span class="font-mono-num text-sm text-accent pt-1">02</span><p class="text-[15px] leading-relaxed text-ink/80">Tekan <strong>Tanya menu via WA</strong> untuk item berlabel Estimasi.</p></li>
          <li class="grid grid-cols-[auto_1fr] gap-4 py-4"><span class="font-mono-num text-sm text-accent pt-1">03</span><p class="text-[15px] leading-relaxed text-ink/80">Reservasi meja lebih dulu bila datang saat jam ramai.</p></li>
        </ol>
      </div>
    </div>
    <div class="mt-10 grid sm:grid-cols-2 gap-3">
      <a href={waAsk} target="_blank" rel="noopener" class="text-center bg-accent text-paper px-6 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-semibold hover:opacity-90 active:scale-[0.98] transition">Tanya menu via WhatsApp</a>
      <a href="/reservasi" class="text-center border border-ink/30 px-6 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-semibold text-ink hover:border-accent hover:text-accent active:scale-[0.98] transition">Reservasi meja</a>
    </div>
  </section>

  <!-- Ref: lokasi singkat — MapFacade klik-untuk-muat + CTA reservasi -->
  <!-- 04 LOKASI -->
  <section aria-label="Lokasi" class="max-w-6xl mx-auto px-4 py-12 md:py-16 border-t border-ink/25">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-start">
      <div class="md:col-span-5 min-w-0">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-ink/60">Lokasi</p>
        <h2 class="mt-3 font-display text-3xl md:text-4xl font-semibold tracking-tight leading-[1.05]">Ambil rute ke Danau Sipin</h2>
        <p class="mt-4 text-[15px] leading-relaxed text-ink/75">{business.address}</p>
        <p class="mt-1 font-mono-num text-sm text-ink/60">{business.hours}</p>
        <a href={waLink(`Halo ${business.name}, saya mau reservasi meja.`)} target="_blank" rel="noopener" class="mt-6 inline-flex items-center justify-center bg-accent text-paper px-7 py-3.5 min-h-[48px] rounded-full font-semibold hover:opacity-90 active:scale-[0.98] transition">Reservasi via WhatsApp</a>
      </div>
      <div class="md:col-span-7 min-w-0"><MapFacade /></div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(menuLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</BaseLayout>
