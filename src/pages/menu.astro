---
import BaseLayout from '../layouts/BaseLayout.astro';
import DishCard from '../components/DishCard.astro';
import { business, menuGroups, waLink } from '../data/business';
const seedFor = (n: string) => `ogi-${n.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const total = menuGroups.reduce((a, g) => a + g.items.length, 0);
const menuLd = {
  '@context': 'https://schema.org', '@type': 'Menu', name: `E-Menu ${business.name}`,
  hasMenuSection: menuGroups.map((g) => ({
    '@type': 'MenuSection', name: g.category,
    hasMenuItem: g.items.map((m) => ({ '@type': 'MenuItem', name: m.name, description: m.desc, offers: { '@type': 'Offer', price: m.price } })),
  })),
};
---
<BaseLayout title="E-Menu OGI Cafe Jambi — Katsu, Quesadilla & Matcha" description="E-menu OGI Cafe Jambi Danau Sipin: Chicken Katsu Don Rp38rb, Quesadilla Rp35rb, Matcha Latte Rp25rb. Label Teruji dari review, Estimasi konfirmasi via WA 0822-8052-3250." canonicalPath="/menu">
  <!-- Ref: Awwwards GEM fullscreen menu + Themetags menu highlight visual -->
  <section class="max-w-6xl mx-auto px-4 py-12 md:py-16">
    <p class="text-sm font-semibold text-orange-800">E-Menu &bull; <span class="font-mono-num">{total} item</span></p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tight leading-[1.02] font-extrabold max-w-[18ch]">Menu yang bikin balik lagi</h1>
    <p class="mt-3 text-base text-stone-600 max-w-[65ch]">Label <strong>Teruji</strong> = disebut di review pengunjung. Label <strong>Estimasi</strong> = harga realistis Jambi, wajib konfirmasi via WA sebelum pesan.</p>
    <!-- Skeleton: tampil saat gambar dimuat -->
    <div id="menu-skel" class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-5" aria-hidden="true">
      {[0, 1, 2, 3].map(() => (
        <div class="skel border border-orange-800/15 rounded-3xl overflow-hidden bg-white/60">
          <div class="skel-block w-full aspect-video"></div>
          <div class="p-6 space-y-3"><div class="skel-block h-5 w-2/3 rounded-full"></div><div class="skel-block h-4 w-1/3 rounded-full"></div></div>
        </div>
      ))}
    </div>
    <div id="menu-real" class="hidden">
      {menuGroups.map((g) => (
        <div class="mt-12">
          <div class="flex items-baseline justify-between gap-4 border-b-2 border-orange-800 pb-3 min-w-0">
            <h2 class="text-2xl font-extrabold tracking-tight min-w-0">{g.category}</h2>
            <span class="font-mono-num text-sm text-orange-800 shrink-0">{String(g.items.length).padStart(2, '0')} item</span>
          </div>
          <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-5">
            {g.items.map((m) => (
              <DishCard name={m.name} price={m.price} badge={m.badge} desc={m.desc} seed={seedFor(m.name)} waHref={waLink(`Halo ${business.name}, saya mau pesan ${m.name} (${m.price}). Apakah tersedia?`)} />
            ))}
          </div>
        </div>
      ))}
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a href={waLink(`Halo ${business.name}, saya mau tanya menu lengkap hari ini.`)} target="_blank" rel="noopener" class="flex-1 text-center bg-orange-800 text-orange-50 px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold">Tanya menu via WA</a>
        <a href="/reservasi" class="flex-1 text-center border border-stone-300 px-6 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold hover:border-orange-800 hover:text-orange-800 transition">Reservasi sekalian</a>
      </div>
    </div>
  </section>
  <script is:inline>
    (function () {
      function show() {
        var s = document.getElementById('menu-skel');
        var r = document.getElementById('menu-real');
        if (s) s.classList.add('hidden');
        if (r) r.classList.remove('hidden');
      }
      if (document.readyState === 'complete') setTimeout(show, 350);
      else window.addEventListener('load', function () { setTimeout(show, 350); });
      setTimeout(show, 2500);
    })();
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(menuLd)} />
</BaseLayout>
