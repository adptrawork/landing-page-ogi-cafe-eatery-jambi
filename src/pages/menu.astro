---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, menuGroups, waLink } from '../data/business';
const menuLd = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  name: `E-Menu ${business.name}`,
  hasMenuSection: menuGroups.map((g) => ({
    '@type': 'MenuSection',
    name: g.category,
    hasMenuItem: g.items.map((m) => ({ '@type': 'MenuItem', name: m.name, description: m.desc, offers: { '@type': 'Offer', price: m.price } })),
  })),
};
---
<BaseLayout title="E-Menu OGI Cafe Jambi — Katsu, Quesadilla & Matcha" description="E-menu OGI Cafe Jambi Danau Sipin: Chicken Katsu Don Rp38rb, Quesadilla Rp35rb, Matcha Latte Rp25rb. Label Teruji dari review, Estimasi konfirmasi via WA 0822-8052-3250." canonicalPath="/menu">
  <section class="max-w-6xl mx-auto px-4 py-12">
    <p class="text-sm font-semibold text-orange-800">E-Menu &bull; <span class="font-mono-num">{menuGroups[0].items.length + menuGroups[1].items.length} item</span></p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tight leading-[1.02] font-extrabold">Menu yang bikin balik lagi</h1>
    <p class="mt-3 text-base text-stone-600 max-w-[65ch]">Label <strong>Teruji</strong> = namanya disebut di review pengunjung. Label <strong>Estimasi</strong> = harga realistis Jambi, wajib konfirmasi via WA sebelum pesan.</p>
    {menuGroups.map((g) => (
      <div class="mt-12">
        <div class="flex items-baseline justify-between gap-4 border-b-2 border-orange-800 pb-3">
          <h2 class="text-2xl font-extrabold tracking-tight">{g.category}</h2>
          <span class="font-mono-num text-sm text-orange-800">{String(g.items.length).padStart(2, '0')} item</span>
        </div>
        <div class="snap-row mt-6 flex gap-5 overflow-x-auto pb-4 md:columns-2 md:block md:overflow-visible">
          {g.items.map((m) => (
            <article class="w-[76%] sm:w-[44%] shrink-0 md:w-full md:mb-6 md:break-inside-avoid border border-orange-800/15 rounded-3xl overflow-hidden bg-white/60">
              <img src={`https://picsum.photos/seed/ogi-${m.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/800/600`} alt={m.name} width="800" height="600" loading="lazy" class="w-full aspect-[16/9] object-cover" />
              <div class="p-6">
                <p class="text-xs font-semibold text-orange-800">{m.badge} &mdash; {m.desc}</p>
                <h3 class="mt-1 font-bold text-lg tracking-tight">{m.name}</h3>
                <div class="mt-3 flex items-center justify-between gap-3">
                  <p class="font-mono-num font-semibold">{m.price}</p>
                  <a href={waLink(`Halo ${business.name}, saya mau pesan ${m.name} (${m.price}). Apakah tersedia?`)} target="_blank" rel="noopener" class="btn-ripple border border-orange-800 text-orange-800 px-5 py-2.5 rounded-full text-sm font-semibold hover:bg-orange-800 hover:text-orange-50 active:scale-[0.97] transition">Pesan via WA</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
    <p class="mt-6 text-sm text-stone-500">Di HP geser menyamping (snap), di desktop tampil masonry. Foto placeholder &mdash; ganti foto asli menu berizin.</p>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(menuLd)} />
</BaseLayout>
