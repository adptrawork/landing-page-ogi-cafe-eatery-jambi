---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 — Nyasar sampai sini? Balik nongkrong" description="Halaman tidak ditemukan di OGI Cafe Jambi. Kembali ke beranda.">
  <div class="max-w-6xl mx-auto px-4 py-20">
    <p class="font-mono-num text-sm text-orange-800">404</p>
    <h1 class="mt-2 text-4xl md:text-6xl tracking-tight font-extrabold">Nyasar sampai sini?</h1>
    <p class="mt-3 text-base text-stone-600">Meja yang kamu cari tidak ada. Meja di OGI masih banyak.</p>
    <a href="/" class="mt-6 inline-block bg-orange-800 text-orange-50 px-7 py-3 rounded-full font-semibold active:scale-[0.97] transition">Balik nongkrong</a>
  </div>
</BaseLayout>
