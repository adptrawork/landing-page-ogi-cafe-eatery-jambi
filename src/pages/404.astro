---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business, waLink } from '../data/business';
---
<BaseLayout title="404 — Halaman tidak ditemukan di OGI Cafe and Eatery" description="Halaman yang kamu cari tidak ada di situs OGI Cafe and Eatery Jambi. Kembali ke beranda, buka e-menu, atau reservasi meja lewat WhatsApp 0822-8052-3250.">
  <!-- Ref: menu journal — halaman 404 ringkas dengan nada hangat, bukan kartu -->
  <section class="max-w-6xl mx-auto px-4 py-20 md:py-28 min-h-[60dvh] grid content-center">
    <p class="font-mono-num text-sm text-ink/70">404</p>
    <h1 class="mt-4 font-display text-4xl sm:text-5xl md:text-6xl font-semibold leading-[1.02] tracking-tight max-w-[16ch]">Meja yang kamu cari tidak ada</h1>
    <p class="mt-5 text-base md:text-lg leading-relaxed text-ink/80 max-w-[55ch]">Tapi meja di OGI masih banyak. Kembali ke beranda, telusuri e-menu, atau langsung pesan lewat WhatsApp.</p>
    <div class="mt-8 grid sm:flex gap-3">
      <a href="/" class="text-center bg-accent text-paper px-7 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-semibold hover:opacity-90 active:scale-[0.98] transition">Balik ke beranda</a>
      <a href="/menu" class="text-center border border-ink/60 px-7 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-semibold text-ink hover:border-accent hover:text-accent active:scale-[0.98] transition">Buka e-menu</a>
      <a href={waLink(`Halo ${business.name}, saya mau reservasi meja.`)} target="_blank" rel="noopener" class="text-center border border-ink/60 px-7 py-3.5 min-h-[48px] inline-flex items-center justify-center rounded-full font-semibold text-ink hover:border-accent hover:text-accent active:scale-[0.98] transition">Chat WhatsApp</a>
    </div>
  </section>
</BaseLayout>
