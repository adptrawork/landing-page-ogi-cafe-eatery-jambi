---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';
interface Props { title: string; description: string; canonicalPath?: string; image?: string; }
const { title, description, canonicalPath = '/', image } = Astro.props;
const site = (Astro.site?.toString() ?? 'https://ogicafe-jambi.pages.dev').replace(/\/$/, '');
const canonicalUrl = `${site}${canonicalPath}`;
import { business, waLink } from '../data/business';
const cta = waLink(`Halo ${business.name}, saya mau reservasi meja.`);
const path = Astro.url.pathname;
const active = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
const linkCls = (h: string) =>
  active(h)
    ? 'text-orange-800 font-semibold underline underline-offset-8 decoration-2'
    : 'hover:text-orange-800 transition';
const ticker = ['Chicken Katsu Don', 'Matcha Latte', 'Board Games', 'Parkir Luas', 'Spot Foto', 'Nongkrong Danau Sipin', 'Kopi Susu Gula Aren'];
---
<!doctype html>
<html lang="id">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} image={image} />
</head>
<body class="antialiased">
  <header class="sticky top-0 z-40 bg-[#faf6f1]/85 backdrop-blur-xl border-b border-orange-800/15">
    <nav class="max-w-6xl mx-auto flex items-center justify-between px-4 py-3">
      <a href="/" class="leading-none">
        <span class="block font-extrabold tracking-tight text-xl">OGI</span>
        <span class="block text-[11px] font-medium tracking-[0.18em] uppercase text-orange-800">Cafe &bull; Danau Sipin</span>
      </a>
      <div class="hidden md:flex gap-6 text-sm text-stone-600">
        <a href="/" class={linkCls('/')}>Beranda</a>
        <a href="/menu" class={linkCls('/menu')}>Menu</a>
        <a href="/reservasi" class={linkCls('/reservasi')}>Reservasi</a>
        <a href="/galeri" class={linkCls('/galeri')}>Galeri</a>
      </div>
      <a href={cta} target="_blank" rel="noopener" class="btn-ripple bg-orange-800 text-orange-50 px-5 py-2.5 rounded-full text-sm font-semibold transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.97]" style="transition-timing-function:cubic-bezier(0.16,1,0.3,1)">Reservasi Meja</a>
    </nav>
    <nav class="md:hidden border-t border-orange-800/10">
      <div class="max-w-6xl mx-auto flex gap-5 overflow-x-auto px-4 py-2.5 text-sm text-stone-600">
        <a href="/" class={linkCls('/')}>Beranda</a>
        <a href="/menu" class={linkCls('/menu')}>Menu</a>
        <a href="/reservasi" class={linkCls('/reservasi')}>Reservasi</a>
        <a href="/galeri" class={linkCls('/galeri')}>Galeri</a>
      </div>
    </nav>
  </header>
  <div class="border-b border-orange-800/15 bg-orange-800/[0.06] overflow-hidden" aria-hidden="true">
    <div class="ticker-track py-2 text-xs font-semibold tracking-[0.16em] uppercase text-orange-800">
      {[...ticker, ...ticker].map((t) => (<span class="whitespace-nowrap">{t} &nbsp;&mdash;</span>))}
    </div>
  </div>
  <main><slot /></main>
  <footer id="kontak" class="mt-20 border-t border-orange-800/15 bg-[#f3ebe2]">
    <div class="max-w-6xl mx-auto px-4 py-12 grid gap-8 md:grid-cols-12">
      <div class="md:col-span-8">
        <p class="font-extrabold tracking-tight text-lg">OGI Cafe and Eatery</p>
        <p class="mt-2 text-base text-stone-600 leading-relaxed max-w-[65ch]">{business.address} &mdash; {business.hours}</p>
        <p class="mt-2 text-sm text-stone-500">Basecamp nongkrong anak muda Danau Sipin: reservasi via WhatsApp, rute via Google Maps.</p>
        <div class="mt-4 flex flex-wrap gap-3 text-sm">
          <a href="/menu" class="underline underline-offset-4 decoration-orange-800">E-Menu</a>
          <a href="/reservasi" class="underline underline-offset-4 decoration-orange-800">Reservasi</a>
          <a href="/galeri" class="underline underline-offset-4 decoration-orange-800">Galeri</a>
        </div>
      </div>
      <div class="md:col-span-4">
        <p class="font-semibold text-sm">Hubungi</p>
        <div class="mt-3 flex flex-col gap-2 text-sm">
          <a href={cta} target="_blank" rel="noopener" class="underline underline-offset-4">WhatsApp 0822-8052-3250</a>
          <a href={business.mapsUrl} target="_blank" rel="noopener" class="underline underline-offset-4">Google Maps &mdash; rute ke lokasi</a>
          <a href={business.instagram} target="_blank" rel="noopener" class="underline underline-offset-4">Instagram @ogi.cafeneatery</a>
        </div>
        <p class="mt-6 text-xs text-stone-400">&copy; 2026 OGI Cafe and Eatery &mdash; Kota Jambi.</p>
      </div>
    </div>
  </footer>
  <script is:inline>
    document.querySelectorAll('.btn-ripple').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        var r = btn.getBoundingClientRect();
        var d = Math.max(r.width, r.height) * 2;
        var s = document.createElement('span');
        s.className = 'ripple-ink';
        s.style.width = d + 'px';
        s.style.height = d + 'px';
        s.style.setProperty('--rx', (e.clientX - r.left - d / 2) + 'px');
        s.style.setProperty('--ry', (e.clientY - r.top - d / 2) + 'px');
        btn.appendChild(s);
        s.addEventListener('animationend', function () { s.remove(); });
      });
    });
  </script>
</body>
</html>
