---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';
interface Props { title: string; description: string; canonicalPath?: string; image?: string; }
const { title, description, canonicalPath = '/', image } = Astro.props;
const site = (Astro.site?.toString() ?? 'https://ogicafe-jambi.pages.dev').replace(/\/$/, '');
const canonicalUrl = `${site}${canonicalPath}`;
import { business, waLink } from '../data/business';
const cta = waLink(`Halo ${business.name}, saya mau reservasi meja.`);
const path = Astro.url.pathname;
const active = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
const linkCls = (h: string) =>
  active(h)
    ? 'text-accent font-semibold'
    : 'text-ink/75 hover:text-accent transition-colors';
const nav = [
  { href: '/', label: 'Beranda' },
  { href: '/menu', label: 'Menu' },
  { href: '/reservasi', label: 'Reservasi' },
  { href: '/galeri', label: 'Galeri' },
];
---
<!doctype html>
<html lang="id">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} image={image} />
</head>
<body class="bg-paper text-ink antialiased">
  <a class="skip-link" href="#main">Lompat ke konten utama</a>
  <!-- Ref: NAP konsisten (alamat/jam/WA) — satu sumber kebenaran di business.ts -->
  <div class="bg-ink/6 text-ink border-b border-ink/25 text-xs">
    <p class="max-w-6xl mx-auto px-4 py-2 leading-relaxed">Jl. Empu Sendok No.54, Danau Sipin &middot; {business.hours} &middot; WA 0822-8052-3250</p>
  </div>
  <header class="sticky top-0 z-40 bg-paper/90 backdrop-blur-md border-b border-ink/25">
    <nav class="max-w-6xl mx-auto grid grid-cols-[1fr_auto] md:grid-cols-[auto_1fr_auto] items-center gap-3 px-4 py-3" aria-label="Navigasi utama">
      <a href="/" class="min-w-0 group">
        <span class="block font-display text-2xl leading-none font-semibold tracking-tight">OGI</span>
        <span class="block mt-0.5 text-[11px] font-medium tracking-[0.2em] uppercase text-ink/60">Cafe &amp; Eatery &middot; Danau Sipin</span>
      </a>
      <div class="hidden md:flex justify-center gap-7 text-[15px]">
        {nav.map((n) => (<a href={n.href} class={linkCls(n.href)} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>))}
      </div>
      <div class="flex items-center justify-end gap-2">
        <a href={cta} target="_blank" rel="noopener" class="hidden sm:inline-flex bg-accent text-paper px-5 py-3 min-h-[44px] items-center rounded-full text-sm font-semibold hover:opacity-90 active:scale-[0.98] transition">Reservasi meja</a>
        <!-- Hamburger 44px, aman 360px -->
        <button id="burger" type="button" class="md:hidden inline-flex items-center justify-center w-11 h-11 min-w-[44px] min-h-[44px] rounded-full border border-ink/40 text-ink" aria-label="Buka menu navigasi">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
      </div>
    </nav>
    <nav id="mnav" class="md:hidden hidden border-t border-ink/25 bg-paper" aria-label="Navigasi seluler">
      <div class="max-w-6xl mx-auto grid px-4 py-2 text-[15px]">
        {nav.map((n) => (
          <a href={n.href} class={`py-3 min-h-[48px] inline-flex items-center border-b border-ink/20 ${active(n.href) ? 'text-accent font-semibold' : 'text-ink/80'}`} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
        <a href={cta} target="_blank" rel="noopener" class="my-3 bg-accent text-paper px-5 py-3 min-h-[48px] inline-flex items-center justify-center rounded-full text-sm font-semibold">Reservasi meja</a>
      </div>
    </nav>
  </header>
  <main id="main"><slot /></main>
  <!-- Ref: NAP ringkas + atribusi gambar (sumber Wikimedia Commons dicatat di README) -->
  <footer class="mt-16 md:mt-24 border-t border-ink/25 bg-ink/6">
    <div class="max-w-6xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-8 min-w-0">
        <p class="font-display text-2xl font-semibold tracking-tight">OGI Cafe and Eatery</p>
        <p class="mt-3 text-[15px] leading-relaxed max-w-[65ch] text-ink">{business.address}</p>
        <p class="mt-1 text-[15px] leading-relaxed text-ink/60">{business.hours} &middot; {business.priceRange}</p>
        <div class="mt-5 grid sm:flex gap-x-5 gap-y-1 text-sm">
          <a href="/menu" class="text-accent underline underline-offset-4 decoration-accent/50 min-h-[44px] inline-flex items-center">E-Menu</a>
          <a href="/reservasi" class="text-accent underline underline-offset-4 decoration-accent/50 min-h-[44px] inline-flex items-center">Reservasi</a>
          <a href="/galeri" class="text-accent underline underline-offset-4 decoration-accent/50 min-h-[44px] inline-flex items-center">Galeri</a>
        </div>
        <p class="mt-6 text-xs leading-relaxed text-ink/60 max-w-[70ch]">
          Kredit gambar: suasana &amp; foto menu dari <a href="https://commons.wikimedia.org" target="_blank" rel="noopener" class="underline underline-offset-2">Wikimedia Commons</a> (CC BY / CC BY-SA / Public domain) — ilustrasi, bukan foto lokasi OGI. Daftar lengkap di README repositori.
        </p>
      </div>
      <div class="md:col-span-4">
        <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-ink/60">Hubungi</p>
        <div class="mt-4 grid gap-2 text-sm">
          <a href={cta} target="_blank" rel="noopener" class="text-ink underline underline-offset-4 decoration-ink/50 min-h-[44px] inline-flex items-center">WhatsApp 0822-8052-3250</a>
          <a href={business.mapsUrl} target="_blank" rel="noopener" class="text-ink underline underline-offset-4 decoration-ink/50 min-h-[44px] inline-flex items-center">Google Maps &mdash; rute ke lokasi</a>
          <a href={business.instagram} target="_blank" rel="noopener" class="text-ink underline underline-offset-4 decoration-ink/50 min-h-[44px] inline-flex items-center">Instagram @ogi.cafeneatery</a>
        </div>
        <p class="mt-6 text-xs text-ink/60">&copy; 2026 OGI Cafe and Eatery &mdash; Kota Jambi.</p>
      </div>
    </div>
  </footer>
  <script is:inline>
    /* JS DIET: toggle nav + maps facade saja (vanilla, tanpa dependency) */
    (function () {
      var b = document.getElementById('burger');
      var n = document.getElementById('mnav');
      if (b && n) b.addEventListener('click', function () {
        var open = n.classList.toggle('hidden');
        b.setAttribute('aria-expanded', String(!open));
        b.setAttribute('aria-label', open ? 'Buka menu navigasi' : 'Tutup menu navigasi');
      });
      document.addEventListener('click', function (e) {
        var t = e.target;
        if (!t || !t.hasAttribute || !t.hasAttribute('data-loadmap')) return;
        var box = t.closest('[data-embed]');
        if (!box) return;
        var f = document.createElement('iframe');
        f.src = box.getAttribute('data-embed');
        f.title = box.getAttribute('data-title') || 'Peta lokasi';
        f.loading = 'lazy';
        f.className = 'w-full h-full';
        box.textContent = '';
        box.appendChild(f);
      });
    })();
  </script>
</body>
</html>
