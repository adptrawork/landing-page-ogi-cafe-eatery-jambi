---
import BaseHead from '../components/BaseHead.astro';
import '../styles/global.css';
interface Props { title: string; description: string; canonicalPath?: string; image?: string; }
const { title, description, canonicalPath = '/', image } = Astro.props;
const site = (Astro.site?.toString() ?? 'https://ogicafe-jambi.pages.dev').replace(/\/$/, '');
const canonicalUrl = `${site}${canonicalPath}`;
import { business, waLink } from '../data/business';
const cta = waLink(`Halo ${business.name}, saya mau tanya stok produk. Apakah ready?`);
---
<!doctype html>
<html lang="id">
<head>
  <BaseHead title={title} description={description} canonicalUrl={canonicalUrl} image={image} />
</head>
<body class="bg-[#f9fafb] text-zinc-950 antialiased">
  <header class="sticky top-0 z-40 bg-white/70 backdrop-blur-xl border-b border-white/10 shadow-[inset_0_1px_0_rgba(255,255,255,0.1)]">
    <nav class="max-w-7xl mx-auto flex items-center justify-between px-4 py-3">
      <a href="/" class="font-bold tracking-tight">{business.name}</a>
      <div class="hidden md:flex gap-6 text-sm text-zinc-600">
        <a href="/" class="hover:text-zinc-950 transition">Beranda</a>
        <a href="/menu" class="hover:text-zinc-950 transition">Menu</a>
        <a href="/reservasi" class="hover:text-zinc-950 transition">Reservasi</a>
        <a href="/galeri" class="hover:text-zinc-950 transition">Galeri</a>
      </div>
      <a href={cta} class="bg-rose-700 text-white px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-300 hover:-translate-y-0.5 active:scale-[0.98]" style="transition-timing-function:cubic-bezier(0.16,1,0.3,1)">Pesan via WA</a>
    </nav>
  </header>
  <main><slot /></main>
  <footer id="kontak" class="mt-20 border-t border-zinc-200 bg-white">
    <div class="max-w-7xl mx-auto px-4 py-12 grid gap-8 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="font-bold tracking-tight text-lg">{business.name}</p>
        <p class="mt-2 text-base text-gray-600 leading-relaxed max-w-[65ch]">{business.address} — {business.hours}</p>
        <p class="mt-2 text-sm text-zinc-500">Katalog online, reservasi via WhatsApp, rute via Google Maps.</p>
      </div>
      <div class="md:col-span-5">
        <p class="font-semibold text-sm">Hubungi</p>
        <div class="mt-3 flex flex-col gap-2 text-sm">
          <a href={cta} class="underline underline-offset-4">WhatsApp reservasi</a>
          <a href={business.mapsUrl} class="underline underline-offset-4">Google Maps — rute ke lokasi</a>
        </div>
        <p class="mt-6 text-xs text-zinc-400">© 2026 {business.name} — Kota Jambi.</p>
      </div>
    </div>
  </footer>
</body>
</html>
